<style>
  :root{
    --teal-900:#0D2530;
    --teal-800:#123640;
    --teal-700:#1B4652;
    --teal-600:#296270;
    --orange-600:#D4732B;
    --orange-500:#E8863C;
    --orange-400:#F0A868;
    --orange-100:#FCE7D3;
    --ink-900:#1B2427;
    --ink-700:#3C494D;
    --slate-500:#5C6B70;
    --slate-400:#7C8C90;
    --paper-0:#FFFFFF;
    --paper-50:#FAF8F3;
    --line-100:#E7E2D8;
    --line-dark:#28444E;
    --cream-100:#D8E1E2;
    --radius:14px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper-0);
    color:var(--ink-900);
    font-family:'Inter',sans-serif;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.display{font-family:'Lora',serif;font-weight:500;letter-spacing:-0.01em;margin:0;}
  em{font-style:italic;color:var(--orange-500);font-weight:500;}
  .mono{font-family:'JetBrains Mono',monospace;}
  a{color:inherit;}
  img{max-width:100%;display:block;}
  .wrap{max-width:1140px;margin:0 auto;padding:0 28px;}

  .eyebrow{
    font-family:'Inter',sans-serif;font-weight:600;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;
    display:inline-flex;align-items:center;gap:9px;
  }
  .eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--orange-500);display:inline-block;flex-shrink:0;}
  .eyebrow.on-light{color:var(--teal-700);}
  .eyebrow.on-dark-pill{
    color:var(--cream-100);border:1px solid var(--line-dark);background:rgba(255,255,255,.03);
    padding:8px 16px;border-radius:999px;
  }

  .btn{
    display:inline-flex;align-items:center;gap:9px;padding:14px 26px;border-radius:999px;font-weight:600;font-size:15px;
    text-decoration:none;cursor:pointer;border:1px solid transparent;
    transition:transform .15s ease, box-shadow .15s ease, background .15s ease;
    font-family:'Inter',sans-serif;
  }
  .btn:hover{transform:translateY(-1px);}
  .btn-primary{background:var(--orange-500);color:#fff;box-shadow:0 10px 26px -10px rgba(232,134,60,.55);}
  .btn-primary:hover{background:var(--orange-600);}
  .btn-copy{
    background:rgba(255,255,255,.08);border:1px solid var(--line-dark);color:var(--cream-100);
    font-size:12.5px;padding:8px 14px;border-radius:8px;cursor:pointer;
  }
  .btn-copy:hover{border-color:var(--orange-400);color:var(--orange-400);}
  .btn-copy.copied{background:var(--orange-500);border-color:var(--orange-500);color:#0A1519;}

  section{padding:80px 0;}
  .section-tight{padding:56px 0;}
  .bg-dark{background:linear-gradient(135deg,var(--teal-700) 0%, var(--teal-900) 78%);}
  .bg-paper{background:var(--paper-50);}

  header{
    position:sticky;top:0;z-index:50;background:rgba(255,255,255,.92);backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line-100);
  }
  .navbar{display:flex;align-items:center;justify-content:space-between;padding:16px 28px;max-width:1140px;margin:0 auto;}
  .brand{display:flex;align-items:center;gap:11px;text-decoration:none;}
  .brand img{width:28px;height:28px;flex-shrink:0;border-radius:6px;}
  .brandmark{display:flex;flex-direction:column;line-height:1.15;}
  .brandmark .top{font-size:14.5px;font-weight:600;color:var(--ink-900);}
  .brandmark .sub{font-size:10.5px;color:var(--slate-400);letter-spacing:.02em;}
  nav{display:flex;align-items:center;gap:30px;}
  .nav-links{display:flex;gap:26px;}
  .nav-links a{font-size:14px;color:var(--ink-700);text-decoration:none;}
  .nav-links a:hover{color:var(--ink-900);}
  @media (max-width:760px){.nav-links{display:none;}}

  .hero{padding:64px 0 56px;}
  .hero-center{max-width:760px;margin:0 auto;text-align:center;}
  .hero h1{font-size:clamp(30px,4.2vw,46px);line-height:1.16;margin:20px 0 18px;color:var(--paper-0);font-weight:500;}
  .hero p.lede{font-size:16.5px;color:var(--cream-100);max-width:600px;margin:0 auto;}

  /* ---------- TABS ---------- */
  .tabs-wrap{padding:44px 0 90px;}
  .tabs{
    display:flex;justify-content:center;gap:6px;margin-bottom:44px;flex-wrap:wrap;
    background:var(--paper-50);border:1px solid var(--line-100);border-radius:999px;padding:6px;
    max-width:fit-content;margin-left:auto;margin-right:auto;
  }
  .tab-btn{
    background:transparent;border:1px solid transparent;color:var(--ink-700);padding:13px 22px;border-radius:999px;
    font-size:14px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:9px;
    transition:all .18s ease;font-family:'Inter',sans-serif;
  }
  .tab-btn .num{font-family:'JetBrains Mono',monospace;font-size:11px;opacity:.6;}
  .tab-btn.active{background:var(--orange-500);color:#fff;box-shadow:0 6px 18px -6px rgba(232,134,60,.6);}
  .tab-btn:hover:not(.active){background:var(--paper-0);}
  .tab-btn:focus-visible{outline:2px solid var(--orange-500);outline-offset:2px;}

  .panel{display:none;}
  .panel.active{display:block;}

  .persona-head{
    display:flex;justify-content:space-between;align-items:flex-start;gap:30px;flex-wrap:wrap;
    max-width:900px;margin:0 auto 40px;
  }
  .persona-head h2{font-size:clamp(24px,3.2vw,32px);margin:10px 0 10px;}
  .persona-head p{color:var(--slate-500);font-size:15px;max-width:600px;margin:0;}
  .difficulty-flag{
    display:inline-flex;align-items:center;gap:8px;background:var(--orange-100);border:1px solid var(--orange-500);
    color:var(--orange-600);font-size:12.5px;font-weight:600;padding:9px 16px;border-radius:999px;white-space:nowrap;
  }

  .panel-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;max-width:1000px;margin:0 auto;}
  @media (max-width:860px){.panel-grid{grid-template-columns:1fr;}}

  .p-card{background:var(--paper-0);border:1px solid var(--line-100);border-radius:var(--radius);padding:28px;margin-bottom:24px;}
  .p-card h3{font-size:16px;font-weight:600;font-family:'Inter',sans-serif;margin-bottom:12px;color:var(--ink-900);}
  .p-card .p-eyebrow{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--orange-600);margin-bottom:8px;display:block;}
  .p-card p{font-size:13.5px;color:var(--slate-500);line-height:1.6;margin:0 0 10px;}
  .p-card p:last-child{margin-bottom:0;}
  .p-card ul{margin:0;padding-left:18px;}
  .p-card li{font-size:13.5px;color:var(--slate-500);margin-bottom:6px;line-height:1.5;}
  .download-btn{
    display:inline-flex;align-items:center;gap:8px;margin-top:16px;
    font-size:13px;font-weight:600;color:var(--orange-600);
    border:1px solid var(--orange-500);border-radius:999px;padding:10px 18px;
    text-decoration:none;background:var(--orange-100);
    transition:background .15s ease, color .15s ease, transform .15s ease;
  }
  .download-btn:hover{background:var(--orange-500);color:#fff;transform:translateY(-1px);}
  .download-note{font-size:11.5px;color:var(--slate-400);margin-top:8px;}

  .code-block{
    position:relative;background:var(--teal-900);border-radius:14px;padding:22px 24px;margin-bottom:0;overflow-x:auto;
  }
  .code-block pre{margin:0;color:#E3ECEE;font-family:'JetBrains Mono',monospace;font-size:12.5px;line-height:1.65;white-space:pre-wrap;word-break:break-word;}
  .code-block .btn-copy{position:absolute;top:14px;right:14px;}

  .critique-item{border-top:1px solid var(--line-100);padding:16px 0;}
  .critique-item:first-child{border-top:none;padding-top:0;}
  .critique-item .ci-when{font-size:12px;color:var(--slate-400);margin-bottom:6px;}
  .critique-item .ci-quote{
    font-family:'Lora',serif;font-style:italic;font-size:13.5px;color:var(--ink-700);
    border-left:2px solid var(--orange-500);padding-left:12px;margin:0;
  }

  .checklist{list-style:none;margin:0;padding:0;}
  .checklist li{display:flex;gap:10px;font-size:13.5px;color:var(--slate-500);margin-bottom:9px;line-height:1.5;}
  .checklist li::before{content:"☐";color:var(--orange-500);flex-shrink:0;}
  .done-bar{
    margin-top:14px;padding-top:14px;border-top:1px dashed var(--line-100);
    font-family:'Lora',serif;font-style:italic;font-size:13.5px;color:var(--slate-500);
  }
  .done-bar strong{color:var(--orange-600);font-weight:600;}

  footer{padding:44px 0;border-top:1px solid var(--line-100);background:var(--paper-0);}
  .footer-row{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;color:var(--slate-400);font-size:13px;}
  .footer-row a{text-decoration:none;color:var(--slate-500);}
  .footer-row a:hover{color:var(--orange-600);}

  ::selection{background:var(--orange-400);color:#0A1519;}
  @media (prefers-reduced-motion: reduce){*{animation:none !important;transition:none !important;}}
</style>
