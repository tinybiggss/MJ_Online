<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Build Together — Week 2 Syllabus — AI Fluency Lab</title>
<meta name="description" content="Everything you need for Week 2 — Build Together: the session agenda, the RCI framework, your custom instructions template, and four fallback projects if you show up empty-handed.">
<link rel="canonical" href="https://mikejones.online/GHN/AIFluency/week-2/">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,500;1,600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --teal-900:#0D2530;
    --teal-800:#123640;
    --teal-700:#1B4652;
    --teal-600:#296270;
    --orange-600:#D4732B;
    --orange-500:#E8863C;
    --orange-400:#F0A868;
    --orange-100:#FCE7D3;
    --ink-900:#1B2427;
    --ink-700:#3C494D;
    --slate-500:#5C6B70;
    --slate-400:#7C8C90;
    --paper-0:#FFFFFF;
    --paper-50:#FAF8F3;
    --line-100:#E7E2D8;
    --line-dark:#28444E;
    --cream-100:#D8E1E2;
    --radius:14px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper-0);
    color:var(--ink-900);
    font-family:'Inter',sans-serif;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.display{
    font-family:'Lora',serif;
    font-weight:500;
    letter-spacing:-0.01em;
    margin:0;
  }
  em{font-style:italic;color:var(--orange-500);font-weight:500;}
  .mono{font-family:'JetBrains Mono',monospace;}
  a{color:inherit;}
  img{max-width:100%;display:block;}
  .wrap{max-width:1140px;margin:0 auto;padding:0 28px;}
  .on-dark{color:var(--paper-0);}

  .eyebrow{
    font-family:'Inter',sans-serif;
    font-weight:600;
    font-size:12px;
    letter-spacing:0.12em;
    text-transform:uppercase;
    display:inline-flex;
    align-items:center;
    gap:9px;
  }
  .eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--orange-500);display:inline-block;flex-shrink:0;}
  .eyebrow.on-light{color:var(--teal-700);}
  .eyebrow.on-dark-pill{
    color:var(--cream-100);
    border:1px solid var(--line-dark);
    background:rgba(255,255,255,.03);
    padding:8px 16px;
    border-radius:999px;
  }

  .btn{
    display:inline-flex;
    align-items:center;
    gap:9px;
    padding:14px 26px;
    border-radius:999px;
    font-weight:600;
    font-size:15px;
    text-decoration:none;
    cursor:pointer;
    border:1px solid transparent;
    transition:transform .15s ease, box-shadow .15s ease, background .15s ease, opacity .15s ease;
    font-family:'Inter',sans-serif;
  }
  .btn:hover{transform:translateY(-1px);}
  .btn-primary{background:var(--orange-500);color:#fff;box-shadow:0 10px 26px -10px rgba(232,134,60,.55);}
  .btn-primary:hover{background:var(--orange-600);}
  .btn-text{background:none;padding:14px 0;color:inherit;border-bottom:1px solid currentColor;border-radius:0;}
  .btn-text:hover{opacity:.75;}
  .btn-ghost{background:rgba(255,255,255,.06);border:1px solid var(--line-dark);color:var(--cream-100);}
  .btn-ghost:hover{background:rgba(255,255,255,.14);}
  .btn-copy{
    background:var(--paper-0);border:1px solid var(--line-100);color:var(--ink-700);
    font-size:12.5px;padding:8px 14px;border-radius:8px;
  }
  .btn-copy:hover{border-color:var(--orange-500);color:var(--orange-600);}
  .btn-copy.copied{background:var(--orange-100);border-color:var(--orange-500);color:var(--orange-600);}

  section{padding:100px 0;position:relative;}
  .section-tight{padding:72px 0;}
  .bg-dark{background:linear-gradient(135deg,var(--teal-700) 0%, var(--teal-900) 78%);}
  .bg-paper{background:var(--paper-50);}

  /* ---------- HEADER ---------- */
  header{
    position:sticky;top:0;z-index:50;
    background:rgba(255,255,255,.92);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line-100);
  }
  .navbar{display:flex;align-items:center;justify-content:space-between;padding:16px 28px;max-width:1140px;margin:0 auto;}
  .brand{display:flex;align-items:center;gap:11px;text-decoration:none;}
  .brand img{width:28px;height:28px;flex-shrink:0;border-radius:6px;}
  .brandmark{display:flex;flex-direction:column;line-height:1.15;}
  .brandmark .top{font-size:14.5px;font-weight:600;color:var(--ink-900);}
  .brandmark .sub{font-size:10.5px;color:var(--slate-400);letter-spacing:.02em;}
  nav{display:flex;align-items:center;gap:30px;}
  .nav-links{display:flex;gap:26px;}
  .nav-links a{font-size:14px;color:var(--ink-700);text-decoration:none;}
  .nav-links a:hover{color:var(--ink-900);}
  @media (max-width:820px){.nav-links{display:none;}}

  /* ---------- SESSION HEADER (doc-style, not a hero pitch) ---------- */
  .doc-header{padding:38px 0 0;}
  .doc-header-row{
    display:flex;justify-content:space-between;align-items:flex-end;gap:44px;flex-wrap:wrap;
    margin:18px 0 32px;
  }
  .dh-title{font-size:clamp(26px,3.4vw,38px);color:var(--paper-0);font-weight:500;line-height:1.2;max-width:600px;}
  .dh-sub{color:var(--cream-100);font-size:15px;max-width:460px;margin:12px 0 0;line-height:1.6;}
  .dh-meta{display:flex;flex-direction:column;gap:9px;flex-shrink:0;}
  .meta-row{display:flex;gap:16px;font-size:13px;align-items:baseline;}
  .meta-row .ml{font-family:'JetBrains Mono',monospace;color:#7C9096;min-width:52px;letter-spacing:.02em;}
  .meta-row .mv{color:var(--cream-100);}
  .doc-toc{display:flex;flex-wrap:wrap;border-top:1px solid var(--line-dark);}
  .doc-toc a{
    display:flex;align-items:center;gap:8px;color:var(--cream-100);text-decoration:none;font-size:13.5px;font-weight:500;
    padding:16px 22px 15px 0;margin-right:24px;border-bottom:2px solid transparent;
    transition:border-color .15s ease, color .15s ease;
  }
  .doc-toc a .mono{color:#7C9096;font-size:11px;}
  .doc-toc a:hover{color:var(--orange-400);border-color:var(--orange-500);}
  @media (max-width:700px){.doc-header-row{align-items:flex-start;}.doc-toc a{margin-right:16px;padding-right:0;}}

  /* ---------- WHERE THIS FITS ---------- */
  .fits-strip{
    max-width:900px;margin:0 auto;padding:22px 30px;
    display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;
    background:var(--paper-0);border:1px solid var(--line-100);border-radius:var(--radius);
  }
  .fits-strip p{margin:0;font-size:14.5px;color:var(--slate-500);max-width:640px;}
  .fits-strip a.link-arrow{color:var(--orange-600);font-weight:600;font-size:14px;text-decoration:none;white-space:nowrap;}
  .fits-strip a.link-arrow:hover{text-decoration:underline;}

  /* ---------- SECTION HEADS ---------- */
  .shift-head{max-width:680px;margin-bottom:52px;}
  .shift-head h2{font-size:clamp(27px,3.4vw,38px);margin:16px 0;line-height:1.2;}
  .shift-head p{color:var(--slate-500);font-size:16.5px;}
  .shift-head.on-dark h2{color:var(--paper-0);}
  .shift-head.on-dark p{color:var(--cream-100);}
  .shift-head.center{margin-left:auto;margin-right:auto;text-align:center;}

  /* ---------- AGENDA TIMELINE ---------- */
  .timeline{position:relative;max-width:820px;margin:0 auto;}
  .timeline::before{
    content:"";position:absolute;left:29px;top:8px;bottom:8px;width:2px;
    background:var(--line-100);
  }
  .t-hint-global{max-width:820px;margin:0 auto 18px;text-align:right;font-size:12px;color:var(--slate-400);font-style:italic;}
  .t-item{position:relative;padding:0 0 14px 76px;}
  .t-item:last-child{padding-bottom:0;}
  .t-dot{
    position:absolute;left:14px;top:2px;width:32px;height:32px;border-radius:50%;
    background:var(--paper-0);border:2px solid var(--orange-500);
    display:flex;align-items:center;justify-content:center;
    font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:600;color:var(--orange-600);
    z-index:1;
  }
  .t-item.is-core .t-dot{background:var(--orange-500);color:#fff;box-shadow:0 6px 18px -6px rgba(232,134,60,.7);}
  .t-item.is-buffer .t-dot{border-color:var(--line-100);color:var(--slate-400);}
  .t-time{font-family:'JetBrains Mono',monospace;font-size:11.5px;color:var(--slate-400);letter-spacing:.03em;margin-bottom:5px;}
  .t-card{background:var(--paper-0);border:1px solid var(--line-100);border-radius:12px;padding:16px 24px;cursor:pointer;transition:border-color .15s ease;}
  .t-card:hover{border-color:var(--orange-500);}
  .t-item.is-core .t-card{border-color:var(--orange-500);background:linear-gradient(180deg,var(--orange-100) 0%, #fff 55%);}
  .t-card h4{font-size:17px;font-weight:500;margin-bottom:0;font-family:'Lora',serif;position:relative;padding-right:26px;}
  .t-card p{margin:0;font-size:14px;color:var(--slate-500);line-height:1.55;}
  .t-card .t-tag{
    display:inline-block;font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;
    color:var(--orange-600);margin-bottom:8px;
  }
  .t-chevron{
    position:absolute;right:0;top:2px;font-size:15px;color:var(--slate-400);
    transition:transform .25s ease, color .25s ease;
  }
  .t-card:hover .t-chevron, .t-card.expanded .t-chevron{transform:rotate(180deg);color:var(--orange-500);}
  .t-details{
    max-height:0;opacity:0;overflow:hidden;
    transition:max-height .35s ease, opacity .25s ease, margin-top .35s ease;
  }
  .t-card:hover .t-details, .t-card.expanded .t-details{max-height:420px;opacity:1;margin-top:10px;}
  .t-substeps{margin-top:14px;padding-top:14px;border-top:1px dashed var(--orange-500);display:flex;flex-direction:column;gap:8px;}
  .t-substep{display:flex;gap:10px;font-size:13px;color:var(--ink-700);}
  .t-substep .ss-time{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--orange-600);flex-shrink:0;min-width:78px;}
  .t-link{display:inline-block;margin-top:6px;color:var(--orange-600);font-weight:600;text-decoration:none;font-size:13.5px;}
  .t-link:hover{text-decoration:underline;}

  /* ---------- RCI DIAGRAM ---------- */
  .rci-flow{display:flex;align-items:stretch;justify-content:center;gap:0;flex-wrap:wrap;margin-bottom:36px;}
  .rci-node{
    flex:1;min-width:200px;max-width:260px;background:rgba(255,255,255,.04);border:1px solid var(--line-dark);
    border-radius:16px;padding:26px 22px;text-align:left;
  }
  .rci-node .rci-tag{
    font-family:'JetBrains Mono',monospace;font-size:14px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;
    color:var(--orange-400);margin-bottom:12px;display:block;
  }
  .rci-node h4{color:#fff;font-size:19px;margin-bottom:9px;font-weight:500;}
  .rci-node p{color:#C4D2D4;font-size:13.5px;margin:0;line-height:1.5;}
  .rci-arrow{display:flex;align-items:center;justify-content:center;color:var(--orange-400);font-size:22px;padding:0 10px;flex-shrink:0;}
  @media (max-width:820px){.rci-arrow{transform:rotate(90deg);padding:6px 0;}}
  .rci-loop{
    max-width:640px;margin:0 auto 40px;text-align:center;
    font-family:'JetBrains Mono',monospace;font-size:15px;font-weight:700;letter-spacing:.01em;color:var(--orange-400);
    border:1px solid var(--orange-500);padding:14px 22px;border-radius:999px;
    background:rgba(232,134,60,.08);
  }
  .rci-table{width:100%;border-collapse:collapse;margin-bottom:30px;}
  .rci-table th,.rci-table td{text-align:left;padding:13px 16px;font-size:13.5px;border-bottom:1px solid var(--line-100);vertical-align:top;}
  .rci-table th{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--slate-400);font-weight:600;}
  .rci-table td.rci-r{color:var(--orange-600);font-weight:600;font-family:'JetBrains Mono',monospace;font-size:12.5px;white-space:nowrap;}
  .rci-table td{color:var(--ink-700);}

  .code-block{
    position:relative;background:var(--teal-900);border-radius:14px;padding:24px 26px;margin-bottom:14px;
    overflow-x:auto;
  }
  .code-block pre{margin:0;color:#E3ECEE;font-family:'JetBrains Mono',monospace;font-size:13px;line-height:1.7;white-space:pre-wrap;word-break:break-word;}
  .code-block .btn-copy{position:absolute;top:14px;right:14px;background:rgba(255,255,255,.08);border-color:var(--line-dark);color:var(--cream-100);}
  .code-block .btn-copy:hover{border-color:var(--orange-400);color:var(--orange-400);}
  .code-block .btn-copy.copied{background:var(--orange-500);border-color:var(--orange-500);color:#0A1519;}

  .why-table{display:flex;flex-direction:column;gap:0;margin-top:8px;}
  .why-row{display:grid;grid-template-columns:220px 1fr;gap:18px;padding:13px 0;border-top:1px solid var(--line-100);}
  .why-row:first-child{border-top:none;}
  .why-row .wl{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--orange-600);}
  .why-row .wr{font-size:13.5px;color:var(--slate-500);line-height:1.5;}
  @media (max-width:640px){.why-row{grid-template-columns:1fr;gap:4px;}}

  /* ---------- CRITIQUE PAUSE ---------- */
  .critique-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:34px;}
  @media (max-width:900px){.critique-steps{grid-template-columns:1fr 1fr;}}
  @media (max-width:560px){.critique-steps{grid-template-columns:1fr;}}
  .cs-step{background:var(--paper-0);border:1px solid var(--line-100);border-radius:12px;padding:20px;}
  .cs-step .cs-n{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--orange-600);font-weight:600;display:block;margin-bottom:8px;}
  .cs-step p{margin:0;font-size:13.5px;color:var(--slate-500);line-height:1.5;}
  .pattern-list{display:flex;flex-direction:column;gap:11px;}
  .pattern-item{font-family:'Lora',serif;font-style:italic;font-size:14px;color:var(--ink-700);border-left:2px solid var(--orange-500);padding-left:14px;margin:0;}

  /* ---------- SAVE & ORGANIZE ---------- */
  .organize-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:22px;}
  @media (max-width:700px){.organize-grid{grid-template-columns:1fr;}}
  .org-card{background:var(--paper-0);border:1px solid var(--line-100);border-radius:var(--radius);padding:26px;}
  .org-card h3{font-size:15.5px;font-weight:600;margin-bottom:14px;font-family:'Inter',sans-serif;}
  .org-card ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:9px;}
  .org-card li{font-size:13.5px;color:var(--slate-500);display:flex;gap:10px;align-items:baseline;}
  .org-card li .mono{color:var(--orange-600);flex-shrink:0;font-size:12.5px;}
  .org-card p{font-size:13.5px;color:var(--slate-500);margin:0;line-height:1.6;}

  /* ---------- BEFORE YOU ARRIVE ---------- */
  .build-categories{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:22px 0 26px;}
  @media (max-width:520px){.build-categories{grid-template-columns:1fr;}}
  .cat-chip{
    display:flex;align-items:center;gap:11px;background:var(--paper-0);border:1px solid var(--line-100);
    border-radius:10px;padding:13px 16px;font-size:13.5px;color:var(--ink-700);cursor:pointer;user-select:none;
    transition:border-color .15s ease, background .15s ease;
  }
  .cat-chip .num{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--slate-400);flex-shrink:0;}
  .cat-chip input{accent-color:var(--orange-500);width:16px;height:16px;flex-shrink:0;}
  .cat-chip:has(input:checked){border-color:var(--orange-500);background:var(--orange-100);}
  .prep-checklist{display:flex;flex-direction:column;gap:11px;background:var(--paper-0);border:1px solid var(--line-100);border-radius:var(--radius);padding:26px;}
  .prep-checklist h4{font-size:15.5px;font-weight:600;margin-bottom:4px;font-family:'Inter',sans-serif;}
  .check-row{display:flex;align-items:flex-start;gap:11px;font-size:13.5px;color:var(--ink-700);}
  .check-row input{accent-color:var(--orange-500);width:16px;height:16px;margin-top:2px;flex-shrink:0;}
  .check-row label{cursor:pointer;line-height:1.5;}
  .reassure{
    margin-top:6px;font-family:'Lora',serif;font-style:italic;color:var(--slate-500);font-size:14px;
    border-left:2px solid var(--orange-500);padding-left:14px;
  }

  /* ---------- FALLBACK REFERENCE CARD ---------- */
  .fallback-cta{
    display:flex;align-items:center;justify-content:space-between;gap:30px;flex-wrap:wrap;
    background:var(--paper-0);border:1px solid var(--line-100);border-radius:var(--radius);padding:34px 38px;
  }
  .fallback-cta .txt{max-width:640px;}
  .fallback-cta h3{font-size:20px;font-weight:500;margin:10px 0 10px;}
  .fallback-cta p{margin:0;font-size:14.5px;color:var(--slate-500);}
  .fallback-personas{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px;}
  .fp-tag{font-size:11.5px;background:var(--paper-50);border:1px solid var(--line-100);border-radius:999px;padding:5px 12px;color:var(--ink-700);}
  .fallback-link{color:var(--orange-600);font-weight:600;font-size:14px;text-decoration:none;border-bottom:1px solid var(--orange-500);padding-bottom:2px;white-space:nowrap;}
  .fallback-link:hover{opacity:.75;}

  /* ---------- WHAT'S NEXT ---------- */
  .next-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:34px;}
  @media (max-width:760px){.next-grid{grid-template-columns:1fr;}}
  .ask-card{background:rgba(255,255,255,.04);border:1px solid var(--line-dark);border-radius:14px;padding:24px;}
  .ask-card .ask-n{font-family:'JetBrains Mono',monospace;font-size:20px;color:var(--orange-400);margin-bottom:8px;display:block;}
  .ask-card h4{color:#fff;font-size:16px;margin-bottom:7px;font-weight:500;}
  .ask-card p{color:#C4D2D4;font-size:13.5px;margin:0;line-height:1.5;}

  /* ---------- INSTRUCTOR / FOOTER ---------- */
  .instructor{
    display:grid;grid-template-columns:150px 1fr;gap:32px;align-items:center;
    background:var(--paper-0);border:1px solid var(--line-100);border-radius:var(--radius);padding:34px;
  }
  @media (max-width:660px){.instructor{grid-template-columns:1fr;text-align:center;}}
  .avatar-ring{
    width:120px;height:120px;border-radius:50%;
    background:linear-gradient(135deg,var(--orange-500),var(--teal-600));
    display:flex;align-items:center;justify-content:center;margin:0 auto;padding:4px;
  }
  .avatar-ring img{width:100%;height:100%;border-radius:50%;object-fit:cover;display:block;}
  .instructor h3{font-size:20px;margin-bottom:5px;font-weight:500;}
  .instructor .role{color:var(--orange-600);font-size:13px;font-weight:600;margin-bottom:10px;}
  .instructor p{color:var(--slate-500);font-size:14px;margin:0;}

  footer{padding:44px 0;border-top:1px solid var(--line-100);background:var(--paper-0);}
  .footer-row{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;color:var(--slate-400);font-size:13px;}
  .footer-row .flinks{display:flex;gap:18px;}
  .footer-row a{text-decoration:none;color:var(--slate-500);}
  .footer-row a:hover{color:var(--orange-600);}

  .draft-note{
    max-width:1140px;margin:0 auto;padding:10px 28px;text-align:center;
    font-size:12px;color:var(--slate-400);font-family:'JetBrains Mono',monospace;
  }

  ::selection{background:var(--orange-400);color:#0A1519;}
  @media (prefers-reduced-motion: reduce){*{animation:none !important;transition:none !important;}}
</style>
</head>
<body>

<header>
  <div class="navbar">
    <a class="brand" href="/GHN/AIFluency/week-2/">
      <img src="/GHN/AIFluency/ghn-logo.png" alt="GHN AI Fluency Lab">
      <div class="brandmark">
        <span class="top">AI Fluency Lab</span>
        <span class="sub">Week 2 · Build Together</span>
      </div>
    </a>
    <nav>
      <div class="nav-links">
        <a href="#prep">Before You Arrive</a>
        <a href="#agenda">Agenda</a>
        <a href="#rci">RCI Framework</a>
        <a href="#fallback">Fallback Projects</a>
      </div>
      <a href="/GHN/AIFluency/" style="font-size:13.5px;font-weight:600;color:var(--orange-600);text-decoration:none;white-space:nowrap;">Lab Overview ↗</a>
    </nav>
  </div>
</header>

<main>
  <!-- SESSION HEADER -->
