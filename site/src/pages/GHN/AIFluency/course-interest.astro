---
import { COURSE_GROUPS, MAX_PICKS, ALL_TOPICS } from "../../../data/course-catalog";
const topicCount = ALL_TOPICS.length;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>What Should We Teach Next? — AI Fluency Lab</title>
<meta name="description" content="Pick up to 10 courses you'd actually take, and rate how much you want each one. Five minutes — it decides what the AI Fluency Lab builds next.">
<meta name="robots" content="noindex">
<link rel="canonical" href="https://mikejones.online/GHN/AIFluency/course-interest/">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,500;1,600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --teal-900:#0D2530; --teal-800:#123640; --teal-700:#1B4652; --teal-600:#296270;
    --orange-600:#D4732B; --orange-500:#E8863C; --orange-400:#F0A868; --orange-100:#FCE7D3;
    --ink-900:#1B2427; --ink-700:#3C494D; --slate-500:#5C6B70; --slate-400:#7C8C90;
    --paper-0:#FFFFFF; --paper-50:#FAF8F3; --line-100:#E7E2D8; --line-dark:#28444E;
    --cream-100:#D8E1E2; --radius:14px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;background:var(--paper-0);color:var(--ink-900);
    font-family:'Inter',sans-serif;font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased;
  }
  h1,h2,h3{font-family:'Lora',serif;font-weight:500;letter-spacing:-0.01em;margin:0;}
  em{font-style:italic;color:var(--orange-500);font-weight:500;}
  .mono{font-family:'JetBrains Mono',monospace;}
  a{color:inherit;}
  .wrap{max-width:940px;margin:0 auto;padding:0 28px;}

  .eyebrow{
    font-family:'Inter',sans-serif;font-weight:600;font-size:13px;letter-spacing:.12em;
    text-transform:uppercase;display:inline-flex;align-items:center;gap:9px;
  }
  .eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--orange-500);display:inline-block;}
  .eyebrow.on-dark-pill{
    color:var(--cream-100);border:1px solid var(--line-dark);background:rgba(255,255,255,.03);
    padding:8px 16px;border-radius:999px;
  }
  .bg-dark{background:linear-gradient(135deg,var(--teal-700) 0%, var(--teal-900) 78%);}

  /* ---------- HERO ---------- */
  .hero{padding:46px 0 54px;}
  .hero h1{font-size:clamp(29px,3.6vw,44px);color:var(--paper-0);line-height:1.18;margin:18px 0 16px;max-width:660px;}
  .hero p{color:var(--cream-100);font-size:17px;max-width:620px;margin:0 0 14px;}
  .hero .how{
    margin-top:26px;background:rgba(255,255,255,.05);border:1px solid var(--line-dark);
    border-radius:var(--radius);padding:22px 26px;max-width:680px;
  }
  .hero .how ol{margin:0;padding-left:20px;display:flex;flex-direction:column;gap:9px;}
  .hero .how li{color:var(--cream-100);font-size:15.5px;line-height:1.55;}
  .hero .how li strong{color:#fff;}

  /* ---------- STICKY PROGRESS ---------- */
  .tracker{
    position:sticky;top:0;z-index:60;background:rgba(255,255,255,.96);
    backdrop-filter:blur(10px);border-bottom:1px solid var(--line-100);
  }
  .tracker-inner{
    max-width:940px;margin:0 auto;padding:14px 28px;
    display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;
  }
  .tracker .count{display:flex;align-items:center;gap:14px;}
  .pips{display:flex;gap:5px;}
  .pip{width:19px;height:7px;border-radius:99px;background:var(--line-100);transition:background .18s ease;}
  .pip.on{background:var(--orange-500);}
  .tracker .label{font-size:15px;color:var(--ink-700);font-weight:500;}
  .tracker .label strong{color:var(--orange-600);}
  .tracker .full{color:var(--orange-600);font-size:13.5px;font-style:italic;font-family:'Lora',serif;}
  .btn{
    display:inline-flex;align-items:center;gap:9px;padding:12px 24px;border-radius:999px;
    font-weight:600;font-size:16px;text-decoration:none;cursor:pointer;border:1px solid transparent;
    font-family:'Inter',sans-serif;transition:background .15s ease,opacity .15s ease,transform .15s ease;
  }
  .btn-primary{background:var(--orange-500);color:#fff;box-shadow:0 10px 26px -10px rgba(232,134,60,.55);}
  .btn-primary:hover:not(:disabled){background:var(--orange-600);transform:translateY(-1px);}
  .btn-primary:disabled{opacity:.4;cursor:not-allowed;box-shadow:none;}

  /* ---------- GROUPS + TOPICS ---------- */
  main{padding:44px 0 0;}
  .group{margin-bottom:44px;}
  .group h2{
    font-size:15px;font-family:'Inter',sans-serif;font-weight:600;text-transform:uppercase;
    letter-spacing:.09em;color:var(--teal-700);margin-bottom:16px;
    padding-bottom:10px;border-bottom:1px solid var(--line-100);
  }
  .topic{
    border:1px solid var(--line-100);border-radius:12px;padding:16px 20px;margin-bottom:10px;
    background:var(--paper-0);transition:border-color .15s ease,background .15s ease,opacity .15s ease;
  }
  .topic:hover{border-color:var(--orange-400);}
  .topic.selected{border-color:var(--orange-500);background:linear-gradient(180deg,var(--orange-100) 0%,#fff 70%);}
  .topic.disabled{opacity:.42;}
  .topic.disabled:hover{border-color:var(--line-100);}
  .topic-head{display:flex;align-items:flex-start;gap:14px;cursor:pointer;}
  .topic.disabled .topic-head{cursor:not-allowed;}
  .topic-head input{
    accent-color:var(--orange-500);width:19px;height:19px;margin-top:3px;flex-shrink:0;cursor:inherit;
  }
  .topic-text .tt{font-size:16.5px;font-weight:600;color:var(--ink-900);display:block;line-height:1.35;}
  .topic-text .tb{font-size:14.5px;color:var(--slate-500);line-height:1.5;}

  .rating{
    display:none;align-items:center;gap:12px;flex-wrap:wrap;
    margin:14px 0 2px;padding-top:14px;border-top:1px dashed var(--orange-500);
  }
  .topic.selected .rating{display:flex;}
  .rating .rl{font-size:13.5px;color:var(--ink-700);font-weight:600;}
  .scale{display:flex;gap:6px;}
  .scale button{
    width:42px;height:38px;border-radius:8px;border:1px solid var(--line-100);background:var(--paper-0);
    font-family:'JetBrains Mono',monospace;font-size:15px;font-weight:600;color:var(--slate-500);
    cursor:pointer;transition:all .13s ease;
  }
  .scale button:hover{border-color:var(--orange-500);color:var(--orange-600);}
  .scale button[aria-pressed="true"]{background:var(--orange-500);border-color:var(--orange-500);color:#fff;}
  .scale-hint{font-size:13px;color:var(--slate-400);font-style:italic;font-family:'Lora',serif;}

  /* ---------- OTHER + ABOUT YOU ---------- */
  .panel{
    background:var(--paper-50);border:1px solid var(--line-100);border-radius:var(--radius);
    padding:28px 30px;margin-bottom:22px;
  }
  .panel h3{font-size:20px;margin-bottom:8px;}
  .panel p{font-size:14.5px;color:var(--slate-500);margin:0 0 16px;}
  label.fl{display:block;font-size:14px;font-weight:600;color:var(--ink-700);margin-bottom:6px;}
  input[type=text],input[type=email],textarea{
    width:100%;padding:12px 14px;border:1px solid var(--line-100);border-radius:9px;
    font-family:'Inter',sans-serif;font-size:16px;color:var(--ink-900);background:var(--paper-0);
  }
  input:focus,textarea:focus{outline:2px solid var(--orange-400);outline-offset:1px;border-color:var(--orange-500);}
  textarea{min-height:88px;resize:vertical;line-height:1.55;}
  .field{margin-bottom:16px;}
  .field:last-child{margin-bottom:0;}
  .two-up{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  @media (max-width:620px){.two-up{grid-template-columns:1fr;}}
  .hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;}

  /* ---------- SUBMIT ---------- */
  .submit-row{
    display:flex;align-items:center;gap:20px;flex-wrap:wrap;
    padding:32px 0 80px;
  }
  .form-msg{font-size:14.5px;margin:0;}
  .form-msg.err{color:#B3452B;}
  .form-msg.ok{color:var(--orange-600);}

  .done{
    display:none;background:var(--orange-100);border:1px solid var(--orange-500);
    border-radius:var(--radius);padding:38px 36px;margin:40px 0 90px;
  }
  .done.show{display:block;}
  .done h2{font-size:26px;margin-bottom:12px;}
  .done p{font-size:16px;color:var(--ink-700);margin:0 0 10px;}
  .done ol{margin:16px 0 0;padding-left:22px;}
  .done li{font-size:15px;color:var(--ink-700);margin-bottom:7px;}

  footer{padding:34px 0;border-top:1px solid var(--line-100);}
  .footer-row{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;color:var(--slate-400);font-size:14px;}
  .footer-row a{text-decoration:none;color:var(--slate-500);}
  .footer-row a:hover{color:var(--orange-600);}
  ::selection{background:var(--orange-400);color:#0A1519;}
  @media (prefers-reduced-motion: reduce){*{transition:none !important;}}
</style>
</head>
<body>

<section class="hero bg-dark">
  <div class="wrap">
    <span class="eyebrow on-dark-pill"><span class="dot"></span>GHN AI FLUENCY LAB · COHORT INPUT</span>
    <h1>What should we teach next?</h1>
    <p>Here's everything on my radar — {topicCount} candidate sessions. I'd rather build the next class around what you'd actually take than what I think you should take.</p>
    <p style="color:var(--orange-400);font-size:15.5px;">Takes about five minutes. I'll share the results back with the cohort.</p>
    <div class="how">
      <ol>
        <li><strong>Pick up to {MAX_PICKS}</strong> — the ones you'd genuinely show up for. The cap is the point: it forces a real choice.</li>
        <li><strong>Rate each one 1–5</strong> — 1 is “mildly curious,” 5 is “I'd pay to attend this.”</li>
        <li><strong>Add anything I missed</strong> at the bottom, then submit.</li>
      </ol>
    </div>
  </div>
</section>

<div class="tracker">
  <div class="tracker-inner">
    <div class="count">
      <div class="pips" id="pips" aria-hidden="true"></div>
      <span class="label"><strong id="cnum">0</strong> of {MAX_PICKS} selected</span>
      <span class="full" id="fullnote" hidden>That's your {MAX_PICKS} — deselect one to swap.</span>
    </div>
    <button class="btn btn-primary" id="submit-top" disabled>Submit my picks</button>
  </div>
</div>

<main>
  <div class="wrap">
    <form id="survey" novalidate>
      {COURSE_GROUPS.map((group) => (
        <section class="group">
          <h2>{group.name}</h2>
          {group.topics.map((topic) => (
            <div class="topic" data-topic={topic.id}>
              <label class="topic-head">
                <input type="checkbox" value={topic.id} data-title={topic.title}>
                <span class="topic-text">
                  <span class="tt">{topic.title}</span>
                  <span class="tb">{topic.blurb}</span>
                </span>
              </label>
              <div class="rating">
                <span class="rl">How much do you want it?</span>
                <div class="scale" role="group" aria-label={`Interest rating for ${topic.title}`}>
                  <button type="button" data-v="1" aria-pressed="false">1</button>
                  <button type="button" data-v="2" aria-pressed="false">2</button>
                  <button type="button" data-v="3" aria-pressed="true">3</button>
                  <button type="button" data-v="4" aria-pressed="false">4</button>
                  <button type="button" data-v="5" aria-pressed="false">5</button>
                </div>
                <span class="scale-hint">1 = mildly curious · 5 = I'd pay to attend</span>
              </div>
            </div>
          ))}
        </section>
      ))}

      <div class="panel">
        <h3>Anything I missed?</h3>
        <p>A topic that isn't on the list — or the one thing you most want answered.</p>
        <div class="field">
          <textarea id="other" name="other" maxlength="800" placeholder="I'd really like a session on…"></textarea>
        </div>
      </div>

      <div class="panel">
        <h3>Who's voting? <span style="font-weight:400;color:var(--slate-400);font-size:15px;">(optional)</span></h3>
        <p>Only so I can follow up if your answer needs a conversation. Leave blank to stay anonymous.</p>
        <div class="two-up">
          <div class="field">
            <label class="fl" for="name">Name</label>
            <input type="text" id="name" name="name" maxlength="120" autocomplete="name">
          </div>
          <div class="field">
            <label class="fl" for="email">Email</label>
            <input type="email" id="email" name="email" maxlength="160" autocomplete="email">
          </div>
        </div>
      </div>

      <div class="hp" aria-hidden="true">
        <label for="company_website">Leave this blank</label>
        <input type="text" id="company_website" name="_honey" tabindex="-1" autocomplete="off">
      </div>

      <div class="submit-row">
        <button class="btn btn-primary" id="submit-bottom" disabled>Submit my picks</button>
        <p class="form-msg" id="msg"></p>
      </div>
    </form>

    <div class="done" id="done">
      <h2>Got it — thank you.</h2>
      <p>Your picks are in. I'll tally the cohort and share what wins.</p>
      <ol id="done-list"></ol>
    </div>
  </div>
</main>

<footer>
  <div class="wrap footer-row">
    <span>GHN AI Fluency Lab</span>
    <div><a href="/GHN/AIFluency/week-3/">← Back to the Week 3 syllabus</a></div>
  </div>
</footer>

<script define:vars={{ MAX_PICKS }}>
  const DRAFT_KEY = 'ghn-course-interest-draft';
  const form = document.getElementById('survey');
  const topics = [...document.querySelectorAll('.topic')];
  const cnum = document.getElementById('cnum');
  const pips = document.getElementById('pips');
  const fullnote = document.getElementById('fullnote');
  const msg = document.getElementById('msg');
  const buttons = [document.getElementById('submit-top'), document.getElementById('submit-bottom')];

  for (let i = 0; i < MAX_PICKS; i++) {
    const p = document.createElement('span');
    p.className = 'pip';
    pips.appendChild(p);
  }
  const pipEls = [...pips.children];

  const selected = () => topics.filter(t => t.querySelector('input').checked);

  function ratingOf(topic) {
    const on = topic.querySelector('.scale button[aria-pressed="true"]');
    return on ? Number(on.dataset.v) : 3;
  }

  function refresh() {
    const n = selected().length;
    cnum.textContent = String(n);
    pipEls.forEach((p, i) => p.classList.toggle('on', i < n));
    fullnote.hidden = n < MAX_PICKS;
    buttons.forEach(b => { b.disabled = n === 0; });
    topics.forEach(t => {
      const checked = t.querySelector('input').checked;
      t.classList.toggle('selected', checked);
      const lock = !checked && n >= MAX_PICKS;
      t.classList.toggle('disabled', lock);
      t.querySelector('input').disabled = lock;
    });
    saveDraft();
  }

  topics.forEach(topic => {
    topic.querySelector('input').addEventListener('change', refresh);
    topic.querySelectorAll('.scale button').forEach(btn => {
      btn.addEventListener('click', () => {
        topic.querySelectorAll('.scale button')
          .forEach(b => b.setAttribute('aria-pressed', String(b === btn)));
        saveDraft();
      });
    });
  });

  function payload() {
    return {
      picks: selected().map(t => {
        const input = t.querySelector('input');
        return { id: input.value, title: input.dataset.title, rating: ratingOf(t) };
      }),
      other: document.getElementById('other').value.trim(),
      name: document.getElementById('name').value.trim(),
      email: document.getElementById('email').value.trim(),
      _honey: document.getElementById('company_website').value.trim(),
    };
  }

  // ---- draft persistence: a refresh mid-survey shouldn't cost you the work
  function saveDraft() {
    try {
      const d = payload();
      delete d._honey;
      localStorage.setItem(DRAFT_KEY, JSON.stringify(d));
    } catch {}
  }

  function loadDraft() {
    let d;
    try { d = JSON.parse(localStorage.getItem(DRAFT_KEY) || 'null'); } catch { return; }
    if (!d || !Array.isArray(d.picks)) return;
    d.picks.forEach(p => {
      const topic = document.querySelector(`.topic[data-topic="${CSS.escape(p.id)}"]`);
      if (!topic) return;
      topic.querySelector('input').checked = true;
      topic.querySelectorAll('.scale button')
        .forEach(b => b.setAttribute('aria-pressed', String(Number(b.dataset.v) === p.rating)));
    });
    if (d.other) document.getElementById('other').value = d.other;
    if (d.name) document.getElementById('name').value = d.name;
    if (d.email) document.getElementById('email').value = d.email;
  }

  async function submit(e) {
    e.preventDefault();
    const body = payload();
    if (!body.picks.length && !body.other) {
      msg.textContent = 'Pick at least one course, or tell me what I missed.';
      msg.className = 'form-msg err';
      return;
    }
    buttons.forEach(b => { b.disabled = true; b.textContent = 'Sending…'; });
    msg.textContent = '';
    try {
      const res = await fetch('/api/course-interest', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const out = await res.json().catch(() => ({}));
      if (!res.ok || !out.ok) throw new Error(out.error || 'Submission failed.');

      const list = document.getElementById('done-list');
      list.innerHTML = '';
      body.picks.slice().sort((a, b) => b.rating - a.rating).forEach(p => {
        const li = document.createElement('li');
        li.textContent = `${p.title} — ${p.rating}/5`;
        list.appendChild(li);
      });
      // The tracker is a sibling of the form, so hiding the form alone would
      // strand the sticky bar with its button still reading "Sending…".
      form.style.display = 'none';
      document.querySelector('.tracker').style.display = 'none';
      document.getElementById('done').classList.add('show');
      try { localStorage.removeItem(DRAFT_KEY); } catch {}
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } catch (err) {
      msg.textContent = err.message + ' You can also just email me your picks.';
      msg.className = 'form-msg err';
      buttons.forEach(b => { b.disabled = false; b.textContent = 'Submit my picks'; });
    }
  }

  buttons.forEach(b => b.addEventListener('click', submit));
  form.addEventListener('submit', submit);

  loadDraft();
  refresh();
</script>

</body>
</html>
