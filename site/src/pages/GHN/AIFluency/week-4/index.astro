<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Product Teardown: Distills — Week 4 Syllabus — AI Fluency Lab</title>
<meta name="description" content="Week 4 of the AI Fluency Lab — take apart a live production Claude app surface by surface, map every decision onto the CCAR-F exam blueprint, and ship one core loop of your own.">
<link rel="canonical" href="https://mikejones.online/GHN/AIFluency/week-4/">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,500;1,600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --teal-900:#0D2530;
    --teal-800:#123640;
    --teal-700:#1B4652;
    --teal-600:#296270;
    --orange-600:#D4732B;
    --orange-500:#E8863C;
    --orange-400:#F0A868;
    --orange-100:#FCE7D3;
    --ink-900:#1B2427;
    --ink-700:#3C494D;
    --slate-500:#5C6B70;
    --slate-400:#7C8C90;
    --paper-0:#FFFFFF;
    --paper-50:#FAF8F3;
    --line-100:#E7E2D8;
    --line-dark:#28444E;
    --cream-100:#D8E1E2;
    --radius:14px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper-0);
    color:var(--ink-900);
    font-family:'Inter',sans-serif;
    font-size:17px;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.display{
    font-family:'Lora',serif;
    font-weight:500;
    letter-spacing:-0.01em;
    margin:0;
  }
  em{font-style:italic;color:var(--orange-500);font-weight:500;}
  .mono{font-family:'JetBrains Mono',monospace;}
  a{color:inherit;}
  img{max-width:100%;display:block;}
  .wrap{max-width:1140px;margin:0 auto;padding:0 28px;}
  .on-dark{color:var(--paper-0);}

  .eyebrow{
    font-family:'Inter',sans-serif;
    font-weight:600;
    font-size:13px;
    letter-spacing:0.12em;
    text-transform:uppercase;
    display:inline-flex;
    align-items:center;
    gap:9px;
  }
  .eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--orange-500);display:inline-block;flex-shrink:0;}
  .eyebrow.on-light{color:var(--teal-700);}
  .eyebrow.on-dark-pill{
    color:var(--cream-100);
    border:1px solid var(--line-dark);
    background:rgba(255,255,255,.03);
    padding:8px 16px;
    border-radius:999px;
  }

  section{padding:100px 0;position:relative;}
  .section-tight{padding:72px 0;}
  .bg-dark{background:linear-gradient(135deg,var(--teal-700) 0%, var(--teal-900) 78%);}
  .bg-paper{background:var(--paper-50);}

  /* ---------- HEADER ---------- */
  header{
    position:sticky;top:0;z-index:50;
    background:rgba(255,255,255,.92);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line-100);
  }
  .navbar{display:flex;align-items:center;justify-content:space-between;padding:16px 28px;max-width:1140px;margin:0 auto;}
  .brand{display:flex;align-items:center;gap:11px;text-decoration:none;}
  .brand img{width:28px;height:28px;flex-shrink:0;border-radius:6px;}
  .brandmark{display:flex;flex-direction:column;line-height:1.15;}
  .brandmark .top{font-size:16px;font-weight:600;color:var(--ink-900);}
  .brandmark .sub{font-size:11.5px;color:var(--slate-400);letter-spacing:.02em;}
  nav{display:flex;align-items:center;gap:30px;}
  .nav-links{display:flex;gap:26px;}
  .nav-links a{font-size:15.5px;color:var(--ink-700);text-decoration:none;}
  .nav-links a:hover{color:var(--ink-900);}
  @media (max-width:900px){.nav-links{display:none;}}

  /* ---------- SESSION HEADER ---------- */
  .doc-header{padding:38px 0 0;}
  .doc-header-row{
    display:flex;justify-content:space-between;align-items:flex-end;gap:44px;flex-wrap:wrap;
    margin:18px 0 32px;
  }
  .dh-title{font-size:clamp(28.5px,3.4vw,42px);color:var(--paper-0);font-weight:500;line-height:1.2;max-width:620px;}
  .dh-sub{color:var(--cream-100);font-size:16.5px;max-width:500px;margin:12px 0 0;line-height:1.6;}
  .dh-meta{display:flex;flex-direction:column;gap:9px;flex-shrink:0;}
  .meta-row{display:flex;gap:16px;font-size:14.5px;align-items:baseline;}
  .meta-row .ml{font-family:'JetBrains Mono',monospace;color:#7C9096;min-width:69px;letter-spacing:.02em;}
  .meta-row .mv{color:var(--cream-100);}
  .doc-toc{display:flex;flex-wrap:wrap;border-top:1px solid var(--line-dark);}
  .doc-toc a{
    display:flex;align-items:center;gap:8px;color:var(--cream-100);text-decoration:none;font-size:15px;font-weight:500;
    padding:16px 22px 15px 0;margin-right:24px;border-bottom:2px solid transparent;
    transition:border-color .15s ease, color .15s ease;
  }
  .doc-toc a .mono{color:#7C9096;font-size:12px;}
  .doc-toc a:hover{color:var(--orange-400);border-color:var(--orange-500);}
  @media (max-width:700px){.doc-header-row{align-items:flex-start;}.doc-toc a{margin-right:16px;padding-right:0;}}

  /* ---------- WHERE THIS FITS ---------- */
  .fits-strip{
    max-width:900px;margin:0 auto;padding:22px 30px;
    display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;
    background:var(--paper-0);border:1px solid var(--line-100);border-radius:var(--radius);
  }
  .fits-strip p{margin:0;font-size:16px;color:var(--slate-500);max-width:640px;}
  .fits-strip a.link-arrow{color:var(--orange-600);font-weight:600;font-size:15.5px;text-decoration:none;white-space:nowrap;}
  .fits-strip a.link-arrow:hover{text-decoration:underline;}

  /* ---------- SECTION HEADS ---------- */
  .shift-head{max-width:760px;margin-bottom:52px;}
  .shift-head h2{font-size:clamp(29.5px,3.4vw,42px);margin:16px 0;line-height:1.2;}
  .shift-head p{color:var(--slate-500);font-size:18px;}
  .shift-head.on-dark h2{color:var(--paper-0);}
  .shift-head.on-dark p{color:var(--cream-100);}
  .shift-head.center{margin-left:auto;margin-right:auto;text-align:center;}

  /* ---------- REMEMBER CALLOUT ---------- */
  .remember{
    position:relative;background:var(--orange-100);border:1px solid var(--orange-500);
    border-left:5px solid var(--orange-500);border-radius:var(--radius);
    padding:26px 30px 24px;margin:34px 0;max-width:900px;
  }
  .remember .rm-label{
    display:inline-flex;align-items:center;gap:8px;
    font-family:'Inter',sans-serif;font-weight:600;font-size:12px;letter-spacing:.12em;text-transform:uppercase;
    color:#fff;background:var(--orange-600);border-radius:999px;padding:5px 14px;margin-bottom:16px;
  }
  .remember h3{font-size:22px;font-weight:500;margin:0 0 14px;}
  .remember ol,.remember ul{margin:0;padding-left:20px;display:flex;flex-direction:column;gap:12px;}
  .remember li{font-size:16px;color:var(--ink-700);line-height:1.6;}
  .remember li strong{color:var(--ink-900);font-weight:600;}
  .remember p{font-size:16px;color:var(--ink-700);margin:0;line-height:1.6;}
  .remember p + p{margin-top:12px;}
  .remember .rm-sub{font-size:14.5px;color:var(--slate-500);margin-top:14px;font-style:italic;font-family:'Lora',serif;}
  .remember.on-dark-rm{background:rgba(232,134,60,.10);border-color:var(--orange-500);border-left-color:var(--orange-400);}
  .remember.on-dark-rm h3{color:#fff;}
  .remember.on-dark-rm li,.remember.on-dark-rm p{color:#D8E1E2;}
  .remember.on-dark-rm li strong{color:#fff;}
  .remember.on-dark-rm .rm-sub{color:#9FB4B8;}
  .remember.on-dark-rm .rm-label{background:var(--orange-500);color:#0A1519;}
  .remember.center{margin-left:auto;margin-right:auto;}

  .keyline{
    font-family:'Lora',serif;font-style:italic;font-size:16.5px;color:var(--ink-700);
    border-left:2px solid var(--orange-500);padding-left:15px;margin:0 0 12px;
  }

  /* ---------- AGENDA TIMELINE ---------- */
  .timeline{position:relative;max-width:820px;margin:0 auto;}
  .timeline::before{content:"";position:absolute;left:29px;top:8px;bottom:8px;width:2px;background:var(--line-100);}
  .t-hint-global{max-width:820px;margin:0 auto 18px;text-align:right;font-size:13px;color:var(--slate-400);font-style:italic;}
  .t-item{position:relative;padding:0 0 14px 76px;}
  .t-item:last-child{padding-bottom:0;}
  .t-dot{
    position:absolute;left:14px;top:2px;width:32px;height:32px;border-radius:50%;
    background:var(--paper-0);border:2px solid var(--orange-500);
    display:flex;align-items:center;justify-content:center;
    font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:600;color:var(--orange-600);
    z-index:1;
  }
  .t-item.is-core .t-dot{background:var(--orange-500);color:#fff;box-shadow:0 6px 18px -6px rgba(232,134,60,.7);}
  .t-item.is-buffer .t-dot{border-color:var(--line-100);color:var(--slate-400);}
  .t-time{font-family:'JetBrains Mono',monospace;font-size:12.5px;color:var(--slate-400);letter-spacing:.03em;margin-bottom:5px;}
  .t-card{background:var(--paper-0);border:1px solid var(--line-100);border-radius:12px;padding:16px 24px;cursor:pointer;transition:border-color .15s ease;}
  .t-card:hover{border-color:var(--orange-500);}
  .t-item.is-core .t-card{border-color:var(--orange-500);background:linear-gradient(180deg,var(--orange-100) 0%, #fff 55%);}
  .t-card h4{font-size:18.5px;font-weight:500;margin-bottom:0;font-family:'Lora',serif;position:relative;padding-right:26px;}
  .t-card p{margin:0;font-size:15.5px;color:var(--slate-500);line-height:1.55;}
  .t-card .t-tag{display:inline-block;font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--orange-600);margin-bottom:8px;}
  .t-chevron{position:absolute;right:0;top:2px;font-size:16.5px;color:var(--slate-400);transition:transform .25s ease, color .25s ease;}
  .t-card:hover .t-chevron, .t-card.expanded .t-chevron{transform:rotate(180deg);color:var(--orange-500);}
  .t-details{max-height:0;opacity:0;overflow:hidden;transition:max-height .35s ease, opacity .25s ease, margin-top .35s ease;}
  .t-card:hover .t-details, .t-card.expanded .t-details{max-height:560px;opacity:1;margin-top:10px;}

  /* ---------- WHAT IS DISTILLS ---------- */
  .pipeline{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin:0 0 8px;}
  @media (max-width:860px){.pipeline{grid-template-columns:1fr 1fr;}}
  @media (max-width:520px){.pipeline{grid-template-columns:1fr;}}
  .pipe-step{
    background:rgba(255,255,255,.05);border:1px solid var(--line-dark);padding:24px 22px;position:relative;
  }
  .pipeline .pipe-step:first-child{border-radius:16px 0 0 16px;}
  .pipeline .pipe-step:last-child{border-radius:0 16px 16px 0;}
  @media (max-width:860px){
    .pipeline .pipe-step{border-radius:0 !important;}
    .pipeline .pipe-step:first-child{border-radius:16px 16px 0 0 !important;}
    .pipeline .pipe-step:last-child{border-radius:0 0 16px 16px !important;}
  }
  .pipe-step .ps-n{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--orange-400);letter-spacing:.08em;text-transform:uppercase;display:block;margin-bottom:10px;}
  .pipe-step h4{color:#fff;font-size:18px;font-weight:500;margin:0 0 8px;font-family:'Lora',serif;}
  .pipe-step p{color:#C4D2D4;font-size:14.5px;margin:0;line-height:1.5;}
  .stack-row{display:flex;flex-wrap:wrap;gap:9px;margin-top:26px;justify-content:center;}
  .stack-pill{
    font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--cream-100);
    background:rgba(255,255,255,.05);border:1px solid var(--line-dark);border-radius:999px;padding:7px 15px;
  }

  /* ---------- ACCORDION (SURFACES) ---------- */
  .acc-list{display:flex;flex-direction:column;gap:14px;max-width:920px;}
  details.acc{
    background:var(--paper-0);border:1px solid var(--line-100);border-radius:var(--radius);
    overflow:hidden;transition:border-color .15s ease, box-shadow .2s ease;
  }
  details.acc[open]{border-color:var(--orange-500);box-shadow:0 12px 30px -22px rgba(27,36,39,.5);}
  details.acc > summary{
    list-style:none;cursor:pointer;padding:22px 26px;display:grid;grid-template-columns:44px 1fr 22px;
    gap:18px;align-items:center;
  }
  details.acc > summary::-webkit-details-marker{display:none;}
  details.acc > summary:hover{background:var(--paper-50);}
  .acc-n{
    font-family:'JetBrains Mono',monospace;font-size:14px;font-weight:600;color:var(--orange-600);
    border:1px solid var(--orange-500);border-radius:8px;width:42px;height:42px;
    display:flex;align-items:center;justify-content:center;flex-shrink:0;
  }
  details.acc.is-twist .acc-n{background:var(--orange-500);color:#fff;border-color:var(--orange-500);}
  .acc-title{font-family:'Lora',serif;font-size:20.5px;font-weight:500;line-height:1.3;display:block;}
  .acc-kicker{display:block;font-family:'Inter',sans-serif;font-size:14px;color:var(--slate-500);margin-top:5px;line-height:1.5;}
  .acc-chev{font-size:17px;color:var(--slate-400);transition:transform .25s ease,color .25s ease;justify-self:end;}
  details.acc[open] .acc-chev{transform:rotate(180deg);color:var(--orange-500);}
  .acc-body{padding:4px 26px 28px 88px;border-top:1px solid var(--line-100);margin-top:2px;padding-top:22px;}
  @media (max-width:640px){
    details.acc > summary{grid-template-columns:36px 1fr 20px;gap:12px;padding:18px;}
    .acc-n{width:36px;height:36px;font-size:12.5px;}
    .acc-title{font-size:18px;}
    .acc-body{padding:20px 18px 24px;}
  }
  .acc-body h5{
    font-family:'Inter',sans-serif;font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;
    color:var(--teal-700);margin:22px 0 10px;
  }
  .acc-body h5:first-child{margin-top:0;}
  .acc-body p{font-size:15.5px;color:var(--ink-700);margin:0 0 12px;line-height:1.62;}
  .acc-body ul{margin:0 0 14px;padding-left:20px;display:flex;flex-direction:column;gap:8px;}
  .acc-body li{font-size:15.5px;color:var(--ink-700);line-height:1.55;}
  .acc-body li strong,.acc-body p strong{color:var(--ink-900);font-weight:600;}
  .acc-body code{
    font-family:'JetBrains Mono',monospace;font-size:13.5px;background:var(--paper-50);
    border:1px solid var(--line-100);border-radius:5px;padding:1.5px 6px;color:var(--teal-700);
  }
  .ask-room{
    background:var(--paper-50);border:1px dashed var(--orange-500);border-radius:12px;
    padding:16px 20px;margin:16px 0 0;
  }
  .ask-room .ar-label{
    font-family:'Inter',sans-serif;font-size:11.5px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;
    color:var(--orange-600);display:block;margin-bottom:7px;
  }
  .ask-room p{margin:0;font-size:15px;color:var(--ink-700);}
  .ask-room p + p{margin-top:9px;}
  .ask-room .answer{color:var(--slate-500);font-style:italic;font-family:'Lora',serif;}

  /* code / prompt block */
  .codeblock{
    background:var(--teal-900);border-radius:10px;padding:18px 20px;margin:0 0 14px;overflow-x:auto;
  }
  .codeblock pre{margin:0;font-family:'JetBrains Mono',monospace;font-size:13px;line-height:1.7;color:#D8E1E2;white-space:pre;}
  .codeblock .c-key{color:var(--orange-400);}
  .codeblock .c-str{color:#9FD3C7;}
  .codeblock .c-com{color:#7C9096;font-style:italic;}
  .cb-label{
    font-family:'JetBrains Mono',monospace;font-size:11.5px;color:var(--slate-400);
    text-transform:uppercase;letter-spacing:.08em;margin-bottom:7px;display:block;
  }

  /* domain badges */
  .dom-row{display:flex;flex-wrap:wrap;gap:7px;margin:0 0 4px;}
  .dom-badge{
    display:inline-flex;align-items:center;gap:6px;font-size:11.5px;font-weight:600;
    letter-spacing:.04em;border-radius:999px;padding:4px 11px;white-space:nowrap;
    background:var(--paper-50);border:1px solid var(--line-100);color:var(--slate-500);
  }
  .dom-badge .dn{font-family:'JetBrains Mono',monospace;color:var(--orange-600);}
  .dom-badge.is-primary{background:var(--orange-100);border-color:var(--orange-500);color:var(--ink-900);}
  .dom-badge.on-dark-badge{background:rgba(255,255,255,.06);border-color:var(--line-dark);color:var(--cream-100);}
  .dom-badge.on-dark-badge .dn{color:var(--orange-400);}

  /* ---------- PRICING SLIDER ---------- */
  .calc{
    max-width:940px;margin:0 auto;background:rgba(255,255,255,.05);
    border:1px solid var(--line-dark);border-radius:18px;padding:34px 36px;
  }
  @media (max-width:640px){.calc{padding:24px 20px;}}
  .calc-grid{display:grid;grid-template-columns:1fr 1fr;gap:34px;}
  @media (max-width:820px){.calc-grid{grid-template-columns:1fr;gap:28px;}}
  .ctl{margin-bottom:24px;}
  .ctl:last-child{margin-bottom:0;}
  .ctl-head{display:flex;justify-content:space-between;align-items:baseline;gap:14px;margin-bottom:10px;}
  .ctl-head label{font-size:14px;font-weight:600;color:var(--cream-100);letter-spacing:.02em;}
  .ctl-head .val{font-family:'JetBrains Mono',monospace;font-size:15px;color:var(--orange-400);font-weight:500;}
  input[type=range]{
    -webkit-appearance:none;appearance:none;width:100%;height:4px;border-radius:999px;
    background:var(--line-dark);outline:none;margin:0;
  }
  input[type=range]::-webkit-slider-thumb{
    -webkit-appearance:none;appearance:none;width:20px;height:20px;border-radius:50%;
    background:var(--orange-500);cursor:pointer;border:3px solid var(--teal-900);
    box-shadow:0 0 0 1px var(--orange-500);
  }
  input[type=range]::-moz-range-thumb{
    width:20px;height:20px;border-radius:50%;background:var(--orange-500);cursor:pointer;
    border:3px solid var(--teal-900);box-shadow:0 0 0 1px var(--orange-500);
  }
  .seg{display:flex;gap:7px;flex-wrap:wrap;}
  .seg button{
    font-family:'Inter',sans-serif;font-size:13.5px;font-weight:600;color:var(--cream-100);
    background:rgba(255,255,255,.04);border:1px solid var(--line-dark);border-radius:999px;
    padding:8px 15px;cursor:pointer;transition:all .15s ease;
  }
  .seg button:hover{border-color:var(--orange-500);color:var(--orange-400);}
  .seg button[aria-pressed="true"]{background:var(--orange-500);border-color:var(--orange-500);color:#0A1519;}
  .seg .sub{display:block;font-size:11px;font-weight:400;opacity:.75;margin-top:1px;}

  .readout{display:flex;flex-direction:column;gap:0;}
  .ro-row{
    display:flex;justify-content:space-between;align-items:baseline;gap:16px;
    padding:13px 0;border-top:1px solid var(--line-dark);
  }
  .ro-row:first-child{border-top:none;padding-top:0;}
  .ro-row .rl{font-size:14.5px;color:#9FB4B8;}
  .ro-row .rv{font-family:'JetBrains Mono',monospace;font-size:16px;color:#fff;font-weight:500;}
  .ro-row.is-hero{padding:18px 0;}
  .ro-row.is-hero .rl{font-size:15.5px;color:var(--cream-100);font-weight:600;}
  .ro-row.is-hero .rv{font-size:26px;}
  .rv.pos{color:#7FD4A8;}
  .rv.neg{color:#F0846C;}
  .verdict{
    margin-top:18px;border-radius:12px;padding:16px 18px;font-size:15px;line-height:1.55;
    border:1px solid var(--line-dark);background:rgba(255,255,255,.04);color:#C4D2D4;
  }
  .verdict.ok{border-color:#3F7F63;background:rgba(127,212,168,.09);color:#CDEBDB;}
  .verdict.bad{border-color:#8E4A3C;background:rgba(240,132,108,.09);color:#F5CFC6;}
  .verdict strong{color:#fff;}
  .calc-note{
    max-width:940px;margin:18px auto 0;font-size:13.5px;color:#7C9096;line-height:1.6;
    font-family:'JetBrains Mono',monospace;
  }

  /* ---------- DOMAIN MAP TABLE ---------- */
  .dmap{max-width:920px;margin:0 auto;}
  .dmap-row{
    display:grid;grid-template-columns:64px 1fr 190px;gap:22px;align-items:center;
    padding:20px 0;border-top:1px solid var(--line-100);
  }
  .dmap-row:first-of-type{border-top:none;}
  @media (max-width:760px){.dmap-row{grid-template-columns:52px 1fr;gap:14px;}.dmap-row .dm-where{grid-column:2;}}
  .dm-wt{
    font-family:'JetBrains Mono',monospace;font-size:19px;font-weight:600;color:var(--orange-600);
    text-align:center;line-height:1.1;
  }
  .dm-wt span{display:block;font-size:10.5px;color:var(--slate-400);font-weight:400;letter-spacing:.06em;margin-top:3px;}
