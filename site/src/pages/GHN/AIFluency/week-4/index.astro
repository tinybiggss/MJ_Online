<script>
  /* agenda timeline expand */
  document.querySelectorAll('.t-card').forEach(card => {
    card.addEventListener('click', (e) => {
      if (e.target.closest('a')) return;
      card.classList.toggle('expanded');
    });
  });

  /* expand-all for the surfaces accordion */
  const expandBtn = document.getElementById('expandAll');
  if (expandBtn) {
    expandBtn.addEventListener('click', () => {
      const items = document.querySelectorAll('#surfaces details.acc');
      const shouldOpen = expandBtn.textContent.trim() === 'Expand all';
      items.forEach(d => { d.open = shouldOpen; });
      expandBtn.textContent = shouldOpen ? 'Collapse all' : 'Expand all';
    });
  }

  /* ---------- unit economics calculator ---------- */
  (function () {
    const MODELS = {
      haiku:  { label: 'Haiku 4.5', inp: 1,  out: 5  },
      sonnet: { label: 'Sonnet',    inp: 3,  out: 15 },
      opus:   { label: 'Opus',      inp: 5,  out: 25 }
    };
    const TOKENS_PER_ENTRY = 340;   // retrieved KB entry
    const BASE_INPUT_TOKENS = 600;  // system prompt + recent history
    const OUTPUT_TOKENS = 300;
    const DAYS = 30;

    let model = 'haiku';
    let price = 24;
    let tierName = 'Pro';

    const qpd = document.getElementById('qpd');
    const ctx = document.getElementById('ctx');
    if (!qpd || !ctx) return;

    const fmt = (n, d) => '$' + n.toFixed(d).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    const int = n => Math.round(n).toLocaleString('en-US');

    function render() {
      const queries = +qpd.value;
      const entries = +ctx.value;
      const m = MODELS[model];

      const inTok = BASE_INPUT_TOKENS + entries * TOKENS_PER_ENTRY;
      const perQuery = (inTok / 1e6) * m.inp + (OUTPUT_TOKENS / 1e6) * m.out;
      const monthlyCost = perQuery * queries * DAYS;
      const margin = price - monthlyCost;
      const breakeven = perQuery > 0 ? price / (perQuery * DAYS) : Infinity;

      document.getElementById('qpdVal').textContent = int(queries);
      document.getElementById('ctxVal').textContent = entries;
      document.getElementById('roTokens').textContent = int(inTok) + ' / ' + int(OUTPUT_TOKENS);
      document.getElementById('roPerQuery').textContent = '$' + perQuery.toFixed(4);
      document.getElementById('roCost').textContent = fmt(monthlyCost, 2);
      document.getElementById('roRev').textContent = fmt(price, 2);

      const marginEl = document.getElementById('roMargin');
      marginEl.textContent = (margin < 0 ? '−' : '') + fmt(Math.abs(margin), 2);
      marginEl.className = 'rv ' + (margin >= 0 ? 'pos' : 'neg');

      const beEl = document.getElementById('roBreakeven');
      beEl.textContent = price === 0 ? 'never — free tier' : int(breakeven) + ' queries/day';

      const v = document.getElementById('verdict');
      if (price === 0) {
        v.className = 'verdict';
        v.innerHTML = '<strong>Free tier.</strong> Every query is pure cost — which is exactly why the free tier is capped at 20 a day. The cap <em>is</em> the business model.';
      } else if (margin < 0) {
        v.className = 'verdict bad';
        v.innerHTML = '<strong>Underwater.</strong> This tier loses money on an average user. Your options: a cheaper model, fewer entries retrieved per query, a lower rate limit, or a higher price. Pick one before you launch, not after.';
      } else if (margin < price * 0.35) {
        v.className = 'verdict';
        v.innerHTML = '<strong>Thin.</strong> Still profitable, but there is no room for a heavier model, a longer context, or a power user. One product decision away from underwater.';
      } else {
        v.className = 'verdict ok';
        v.innerHTML = '<strong>Comfortable.</strong> You could give away more headroom here, or spend it on a better model. Both are real choices — make it deliberately.';
      }
    }

    qpd.addEventListener('input', render);
    ctx.addEventListener('input', render);

    document.querySelectorAll('#modelSeg button').forEach(b => {
      b.addEventListener('click', () => {
        model = b.dataset.model;
        document.querySelectorAll('#modelSeg button').forEach(x =>
          x.setAttribute('aria-pressed', String(x === b)));
        render();
      });
    });

    document.querySelectorAll('#tierSeg button').forEach(b => {
      b.addEventListener('click', () => {
        price = +b.dataset.price;
        tierName = b.dataset.tier;
        document.querySelectorAll('#tierSeg button').forEach(x =>
          x.setAttribute('aria-pressed', String(x === b)));
        render();
      });
    });

    render();
  })();
</script>

