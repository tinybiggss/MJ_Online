<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Spec-Driven &amp; Benchmarks — Week 3 Syllabus — AI Fluency Lab</title>
<meta name="description" content="Week 3 of the AI Fluency Lab — what's changed in AI, spec-driven development end to end, and how to tell when a benchmark is being sold to you.">
<link rel="canonical" href="https://mikejones.online/GHN/AIFluency/week-3/">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,500;1,600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --teal-900:#0D2530;
    --teal-800:#123640;
    --teal-700:#1B4652;
    --teal-600:#296270;
    --orange-600:#D4732B;
    --orange-500:#E8863C;
    --orange-400:#F0A868;
    --orange-100:#FCE7D3;
    --ink-900:#1B2427;
    --ink-700:#3C494D;
    --slate-500:#5C6B70;
    --slate-400:#7C8C90;
    --paper-0:#FFFFFF;
    --paper-50:#FAF8F3;
    --line-100:#E7E2D8;
    --line-dark:#28444E;
    --cream-100:#D8E1E2;
    --radius:14px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper-0);
    color:var(--ink-900);
    font-family:'Inter',sans-serif;
    font-size:17px;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.display{
    font-family:'Lora',serif;
    font-weight:500;
    letter-spacing:-0.01em;
    margin:0;
  }
  em{font-style:italic;color:var(--orange-500);font-weight:500;}
  .mono{font-family:'JetBrains Mono',monospace;}
  a{color:inherit;}
  img{max-width:100%;display:block;}
  .wrap{max-width:1140px;margin:0 auto;padding:0 28px;}
  .on-dark{color:var(--paper-0);}

  .eyebrow{
    font-family:'Inter',sans-serif;
    font-weight:600;
    font-size:13px;
    letter-spacing:0.12em;
    text-transform:uppercase;
    display:inline-flex;
    align-items:center;
    gap:9px;
  }
  .eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--orange-500);display:inline-block;flex-shrink:0;}
  .eyebrow.on-light{color:var(--teal-700);}
  .eyebrow.on-dark-pill{
    color:var(--cream-100);
    border:1px solid var(--line-dark);
    background:rgba(255,255,255,.03);
    padding:8px 16px;
    border-radius:999px;
  }

  section{padding:100px 0;position:relative;}
  .section-tight{padding:72px 0;}
  .bg-dark{background:linear-gradient(135deg,var(--teal-700) 0%, var(--teal-900) 78%);}
  .bg-paper{background:var(--paper-50);}

  /* ---------- HEADER ---------- */
  header{
    position:sticky;top:0;z-index:50;
    background:rgba(255,255,255,.92);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line-100);
  }
  .navbar{display:flex;align-items:center;justify-content:space-between;padding:16px 28px;max-width:1140px;margin:0 auto;}
  .brand{display:flex;align-items:center;gap:11px;text-decoration:none;}
  .brand img{width:28px;height:28px;flex-shrink:0;border-radius:6px;}
  .brandmark{display:flex;flex-direction:column;line-height:1.15;}
  .brandmark .top{font-size:16px;font-weight:600;color:var(--ink-900);}
  .brandmark .sub{font-size:11.5px;color:var(--slate-400);letter-spacing:.02em;}
  nav{display:flex;align-items:center;gap:30px;}
  .nav-links{display:flex;gap:26px;}
  .nav-links a{font-size:15.5px;color:var(--ink-700);text-decoration:none;}
  .nav-links a:hover{color:var(--ink-900);}
  @media (max-width:900px){.nav-links{display:none;}}

  /* ---------- SESSION HEADER ---------- */
  .doc-header{padding:38px 0 0;}
  .doc-header-row{
    display:flex;justify-content:space-between;align-items:flex-end;gap:44px;flex-wrap:wrap;
    margin:18px 0 32px;
  }
  .dh-title{font-size:clamp(28.5px,3.4vw,42px);color:var(--paper-0);font-weight:500;line-height:1.2;max-width:600px;}
  .dh-sub{color:var(--cream-100);font-size:16.5px;max-width:480px;margin:12px 0 0;line-height:1.6;}
  .dh-meta{display:flex;flex-direction:column;gap:9px;flex-shrink:0;}
  .meta-row{display:flex;gap:16px;font-size:14.5px;align-items:baseline;}
  .meta-row .ml{font-family:'JetBrains Mono',monospace;color:#7C9096;min-width:69px;letter-spacing:.02em;}
  .meta-row .mv{color:var(--cream-100);}
  .doc-toc{display:flex;flex-wrap:wrap;border-top:1px solid var(--line-dark);}
  .doc-toc a{
    display:flex;align-items:center;gap:8px;color:var(--cream-100);text-decoration:none;font-size:15px;font-weight:500;
    padding:16px 22px 15px 0;margin-right:24px;border-bottom:2px solid transparent;
    transition:border-color .15s ease, color .15s ease;
  }
  .doc-toc a .mono{color:#7C9096;font-size:12px;}
  .doc-toc a:hover{color:var(--orange-400);border-color:var(--orange-500);}
  @media (max-width:700px){.doc-header-row{align-items:flex-start;}.doc-toc a{margin-right:16px;padding-right:0;}}

  /* ---------- WHERE THIS FITS ---------- */
  .fits-strip{
    max-width:900px;margin:0 auto;padding:22px 30px;
    display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;
    background:var(--paper-0);border:1px solid var(--line-100);border-radius:var(--radius);
  }
  .fits-strip p{margin:0;font-size:16px;color:var(--slate-500);max-width:640px;}
  .fits-strip a.link-arrow{color:var(--orange-600);font-weight:600;font-size:15.5px;text-decoration:none;white-space:nowrap;}
  .fits-strip a.link-arrow:hover{text-decoration:underline;}

  /* ---------- SECTION HEADS ---------- */
  .shift-head{max-width:720px;margin-bottom:52px;}
  .shift-head h2{font-size:clamp(29.5px,3.4vw,42px);margin:16px 0;line-height:1.2;}
  .shift-head p{color:var(--slate-500);font-size:18px;}
  .shift-head.on-dark h2{color:var(--paper-0);}
  .shift-head.on-dark p{color:var(--cream-100);}
  .shift-head.center{margin-left:auto;margin-right:auto;text-align:center;}

  /* ---------- ★ REMEMBER THIS — the retention callout ---------- */
  .remember{
    position:relative;background:var(--orange-100);border:1px solid var(--orange-500);
    border-left:5px solid var(--orange-500);border-radius:var(--radius);
    padding:26px 30px 24px;margin:34px 0;max-width:900px;
  }
  .remember .rm-label{
    display:inline-flex;align-items:center;gap:8px;
    font-family:'Inter',sans-serif;font-weight:600;font-size:12px;letter-spacing:.12em;text-transform:uppercase;
    color:#fff;background:var(--orange-600);border-radius:999px;padding:5px 14px;margin-bottom:16px;
  }
  .remember h3{font-size:22px;font-weight:500;margin:0 0 14px;}
  .remember ol,.remember ul{margin:0;padding-left:20px;display:flex;flex-direction:column;gap:12px;}
  .remember li{font-size:16px;color:var(--ink-700);line-height:1.6;}
  .remember li strong{color:var(--ink-900);font-weight:600;}
  .remember p{font-size:16px;color:var(--ink-700);margin:0;line-height:1.6;}
  .remember p + p{margin-top:12px;}
  .remember .rm-sub{font-size:14.5px;color:var(--slate-500);margin-top:14px;font-style:italic;font-family:'Lora',serif;}
  /* dark-section variant */
  .remember.on-dark-rm{
    background:rgba(232,134,60,.10);border-color:var(--orange-500);border-left-color:var(--orange-400);
  }
  .remember.on-dark-rm h3{color:#fff;}
  .remember.on-dark-rm li,.remember.on-dark-rm p{color:#D8E1E2;}
  .remember.on-dark-rm li strong{color:#fff;}
  .remember.on-dark-rm .rm-sub{color:#9FB4B8;}
  .remember.on-dark-rm .rm-label{background:var(--orange-500);color:#0A1519;}
  .remember.center{margin-left:auto;margin-right:auto;}

  /* one-line "say it this way" quote */
  .keyline{
    font-family:'Lora',serif;font-style:italic;font-size:16.5px;color:var(--ink-700);
    border-left:2px solid var(--orange-500);padding-left:15px;margin:0 0 12px;
  }

  /* ---------- AGENDA TIMELINE ---------- */
  .timeline{position:relative;max-width:820px;margin:0 auto;}
  .timeline::before{content:"";position:absolute;left:29px;top:8px;bottom:8px;width:2px;background:var(--line-100);}
  .t-hint-global{max-width:820px;margin:0 auto 18px;text-align:right;font-size:13px;color:var(--slate-400);font-style:italic;}
  .t-item{position:relative;padding:0 0 14px 76px;}
  .t-item:last-child{padding-bottom:0;}
  .t-dot{
    position:absolute;left:14px;top:2px;width:32px;height:32px;border-radius:50%;
    background:var(--paper-0);border:2px solid var(--orange-500);
    display:flex;align-items:center;justify-content:center;
    font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:600;color:var(--orange-600);
    z-index:1;
  }
  .t-item.is-core .t-dot{background:var(--orange-500);color:#fff;box-shadow:0 6px 18px -6px rgba(232,134,60,.7);}
  .t-item.is-buffer .t-dot{border-color:var(--line-100);color:var(--slate-400);}
  .t-time{font-family:'JetBrains Mono',monospace;font-size:12.5px;color:var(--slate-400);letter-spacing:.03em;margin-bottom:5px;}
  .t-card{background:var(--paper-0);border:1px solid var(--line-100);border-radius:12px;padding:16px 24px;cursor:pointer;transition:border-color .15s ease;}
  .t-card:hover{border-color:var(--orange-500);}
  .t-item.is-core .t-card{border-color:var(--orange-500);background:linear-gradient(180deg,var(--orange-100) 0%, #fff 55%);}
  .t-card h4{font-size:18.5px;font-weight:500;margin-bottom:0;font-family:'Lora',serif;position:relative;padding-right:26px;}
  .t-card p{margin:0;font-size:15.5px;color:var(--slate-500);line-height:1.55;}
  .t-card .t-tag{display:inline-block;font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--orange-600);margin-bottom:8px;}
  .t-chevron{position:absolute;right:0;top:2px;font-size:16.5px;color:var(--slate-400);transition:transform .25s ease, color .25s ease;}
  .t-card:hover .t-chevron, .t-card.expanded .t-chevron{transform:rotate(180deg);color:var(--orange-500);}
  .t-details{max-height:0;opacity:0;overflow:hidden;transition:max-height .35s ease, opacity .25s ease, margin-top .35s ease;}
  .t-card:hover .t-details, .t-card.expanded .t-details{max-height:560px;opacity:1;margin-top:10px;}
  .t-substeps{margin-top:14px;padding-top:14px;border-top:1px dashed var(--orange-500);display:flex;flex-direction:column;gap:8px;}
  .t-substep{display:flex;gap:10px;font-size:14.5px;color:var(--ink-700);}
  .t-substep .ss-time{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--orange-600);flex-shrink:0;min-width:53px;}
  .t-link{display:inline-block;margin-top:6px;color:var(--orange-600);font-weight:600;text-decoration:none;font-size:15px;}
  .t-link:hover{text-decoration:underline;}

  /* ---------- ANCHORS (BLOCK 1) ---------- */
  .anchor-list{display:flex;flex-direction:column;gap:16px;max-width:920px;}
  .anchor{
    background:var(--paper-0);border:1px solid var(--line-100);border-radius:var(--radius);
    padding:24px 28px;display:grid;grid-template-columns:52px 1fr;gap:20px;align-items:start;
  }
  @media (max-width:600px){.anchor{grid-template-columns:1fr;gap:10px;}}
  .anchor.is-lead{border-color:var(--orange-500);background:linear-gradient(180deg,var(--orange-100) 0%, #fff 40%);}
  .anchor .a-n{
    font-family:'JetBrains Mono',monospace;font-size:14.5px;font-weight:600;color:var(--orange-600);
    border:1px solid var(--orange-500);border-radius:8px;width:42px;height:42px;
    display:flex;align-items:center;justify-content:center;
  }
  .anchor h4{font-family:'Lora',serif;font-size:21px;font-weight:500;margin:0 0 10px;}
  .anchor .a-why{margin:0;font-size:15px;color:var(--slate-500);line-height:1.55;}
  .anchor .a-why strong{color:var(--ink-900);}
  .anchor ul.a-facts{margin:0 0 12px;padding-left:18px;display:flex;flex-direction:column;gap:6px;}
  .anchor ul.a-facts li{font-size:15px;color:var(--slate-500);line-height:1.5;}
  .anchor .a-meta{font-size:12px;font-family:'JetBrains Mono',monospace;color:var(--slate-400);margin-top:12px;display:block;}
  .anchor .a-badge{
    display:inline-block;font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;
    color:#fff;background:var(--orange-500);border-radius:999px;padding:3px 10px;margin-bottom:8px;
  }
  .anchor.is-optional{border-style:dashed;background:var(--paper-50);}
  .anchor.is-optional .a-n{border-color:var(--slate-400);color:var(--slate-500);}
  .anchor .a-badge.muted{background:var(--slate-400);}

  /* ---------- SPEC CYCLE (BLOCK 2) ---------- */
  .stage{
    display:grid;grid-template-columns:120px 1fr;gap:28px;
    padding:30px 0;border-top:1px solid var(--line-100);
  }
  .stage:first-of-type{border-top:none;}
  @media (max-width:760px){.stage{grid-template-columns:1fr;gap:12px;}}
  .stage-num{display:flex;flex-direction:column;gap:6px;}
  .stage-num .sn{
    font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:700;color:var(--orange-600);
    letter-spacing:.04em;text-transform:uppercase;
  }
  .stage-num .st{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--slate-400);}
  .stage-body h3{font-size:24px;font-weight:500;margin:0 0 8px;}
  .stage-body > p{color:var(--slate-500);font-size:16px;margin:0 0 14px;line-height:1.6;}
  .stage-body ul{margin:0 0 14px;padding-left:20px;display:flex;flex-direction:column;gap:9px;}
  .stage-body li{font-size:15.5px;color:var(--ink-700);line-height:1.55;}
  .stage-body li strong{color:var(--ink-900);font-weight:600;}
  .handoff{
    display:inline-flex;align-items:center;gap:10px;background:var(--teal-900);color:#E3ECEE;
    font-family:'JetBrains Mono',monospace;font-size:14px;padding:10px 16px;border-radius:8px;margin-bottom:14px;
  }
  .handoff .hf-label{color:var(--orange-400);font-size:11.5px;text-transform:uppercase;letter-spacing:.08em;flex-shrink:0;}
  .stage-body .remember{margin:18px 0 0;}
  .review-loop{
    background:var(--paper-50);border:1px dashed var(--orange-500);border-radius:12px;padding:20px 24px;margin:0 0 14px;
  }
  .review-loop h4{font-family:'Inter',sans-serif;font-size:15px;font-weight:600;margin:0 0 10px;color:var(--ink-900);}
  .review-loop ul{margin:0;padding-left:20px;display:flex;flex-direction:column;gap:7px;}
  .review-loop li{font-size:15px;color:var(--slate-500);}

  /* ---------- BLOCK 3 ---------- */
  .three-things{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
  @media (max-width:900px){.three-things{grid-template-columns:1fr;}}
  .tt-card{background:rgba(255,255,255,.05);border:1px solid var(--orange-500);border-radius:16px;padding:26px 24px;}
  .tt-card .tt-n{
    font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:700;color:#0A1519;background:var(--orange-400);
    border-radius:999px;padding:4px 12px;display:inline-block;margin-bottom:14px;
  }
  .tt-card h4{color:#fff;font-size:21px;margin-bottom:12px;font-weight:500;line-height:1.3;}
  .tt-card ul{margin:0;padding-left:18px;display:flex;flex-direction:column;gap:8px;}
  .tt-card li{color:#C4D2D4;font-size:15px;line-height:1.5;}
  .tt-card li strong{color:#fff;}
  .tt-card a{color:var(--orange-400);word-break:break-word;}

  .q-list{display:flex;flex-direction:column;gap:0;max-width:860px;}
  .q-row{display:grid;grid-template-columns:44px 1fr;gap:20px;padding:20px 0;border-top:1px solid var(--line-dark);}
  .q-row:first-child{border-top:none;}
  .q-row .q-n{
    font-family:'JetBrains Mono',monospace;font-size:16.5px;font-weight:700;color:var(--orange-400);
  }
  .q-row h4{color:#fff;font-size:18px;margin:0 0 6px;font-weight:500;}
  .q-row p{color:#C4D2D4;font-size:15px;margin:0;line-height:1.55;}

  .link-list{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px;}
  .link-pill{
    display:inline-flex;align-items:center;gap:8px;font-size:14px;color:var(--cream-100);
    background:rgba(255,255,255,.05);border:1px solid var(--line-dark);border-radius:999px;
    padding:8px 15px;text-decoration:none;transition:border-color .15s ease,color .15s ease;
  }
  .link-pill:hover{border-color:var(--orange-500);color:var(--orange-400);}

  /* ---------- VOTE CTA ---------- */
  .vote-cta{
    max-width:900px;margin:34px auto 0;display:flex;align-items:center;justify-content:space-between;
    gap:32px;flex-wrap:wrap;background:var(--teal-900);border-radius:var(--radius);padding:34px 38px;
  }
  .vote-cta .vote-txt{max-width:600px;}
  .vote-cta .eyebrow{color:var(--orange-400);margin-bottom:10px;}
  .vote-cta h3{color:#fff;font-size:24px;font-weight:500;margin:0 0 10px;}
  .vote-cta p{color:#C4D2D4;font-size:15.5px;margin:0;line-height:1.6;}
  .vote-btn{
    display:inline-flex;align-items:center;gap:9px;background:var(--orange-500);color:#fff;
    padding:14px 28px;border-radius:999px;font-weight:600;font-size:16px;text-decoration:none;
    white-space:nowrap;box-shadow:0 10px 26px -10px rgba(232,134,60,.55);transition:background .15s ease,transform .15s ease;
  }
  .vote-btn:hover{background:var(--orange-600);transform:translateY(-1px);}

  /* ---------- TOPIC MENU ---------- */
  .topic-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  @media (max-width:700px){.topic-grid{grid-template-columns:1fr;}}
  .topic-chip{
    display:flex;align-items:flex-start;gap:12px;background:var(--paper-0);border:1px solid var(--line-100);
    border-radius:10px;padding:15px 18px;
  }
  .topic-chip .num{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--orange-600);flex-shrink:0;padding-top:2px;}
  .topic-chip .tt{color:var(--ink-900);font-size:15.5px;font-weight:600;display:block;}
  .topic-chip .td{color:var(--slate-500);font-size:14px;line-height:1.45;}

  /* ---------- FRAMEWORKS REFERENCE ---------- */
  .stack-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-bottom:30px;}
  @media (max-width:900px){.stack-grid{grid-template-columns:1fr;}}
  .stack-layer{background:rgba(255,255,255,.04);border:1px solid var(--line-dark);padding:26px 24px;}
  .stack-grid .stack-layer:first-child{border-radius:16px 0 0 16px;}
  .stack-grid .stack-layer:last-child{border-radius:0 16px 16px 0;}
  @media (max-width:900px){
    .stack-grid .stack-layer:first-child{border-radius:16px 16px 0 0;}
    .stack-grid .stack-layer:last-child{border-radius:0 0 16px 16px;}
  }
  .stack-layer .sl-tag{
    font-family:'JetBrains Mono',monospace;font-size:14.5px;font-weight:700;letter-spacing:.03em;
    color:var(--orange-400);margin-bottom:6px;display:block;
  }
  .stack-layer .sl-role{font-size:12.5px;text-transform:uppercase;letter-spacing:.08em;color:#7C9096;margin-bottom:14px;display:block;}
  .stack-layer ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:10px;}
  .stack-layer li{color:#C4D2D4;font-size:15px;line-height:1.5;}
  .stack-layer li strong{color:#fff;font-weight:600;display:block;font-size:15.5px;}
  .diagram-frame{
    max-width:820px;margin:44px auto 0;background:rgba(255,255,255,.05);border:1px solid var(--line-dark);
    border-radius:16px;padding:20px;
  }
  .diagram-frame img{border-radius:10px;background:#fff;}
  .diagram-frame figcaption{color:#9FB4B8;font-size:14px;margin-top:14px;text-align:center;line-height:1.5;}
  /* light-section variant (Block 2 sits on --paper-50) */
  .diagram-frame.on-light{background:var(--paper-0);border-color:var(--line-100);}
  .diagram-frame.on-light figcaption{color:var(--slate-400);}

  /* ---------- INSTRUCTOR / FOOTER ---------- */
  .instructor{
    display:grid;grid-template-columns:150px 1fr;gap:32px;align-items:center;
    background:var(--paper-0);border:1px solid var(--line-100);border-radius:var(--radius);padding:34px;
  }
  @media (max-width:660px){.instructor{grid-template-columns:1fr;text-align:center;}}
  .avatar-ring{
    width:120px;height:120px;border-radius:50%;
    background:linear-gradient(135deg,var(--orange-500),var(--teal-600));
    display:flex;align-items:center;justify-content:center;margin:0 auto;padding:4px;
  }
  .avatar-ring img{width:100%;height:100%;border-radius:50%;object-fit:cover;display:block;}
