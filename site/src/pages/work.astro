---
import FieldLayout from "../layouts/FieldLayout.astro";
import { getCollection } from "astro:content";
import { publishedCases, CASE_ORDER } from "../lib/case-studies";
import { ventures, projects, projectGroups, identity } from "../lib/content";
import "../styles/work.css";

const cases = await publishedCases();
// Review fix 1: the lead row (NeighborhoodShare, the strongest piece) carries
// its product plate; the other two stay plain rows.
const LEAD_CASE = CASE_ORDER[0];

/**
 * The systems index keeps the verbatim content.ts copy; the entries whose
 * name maps to a published case link to that case study.
 */
const CASE_PROJECTS: Record<string, string> = {
  [cases[0]?.data?.short ?? ""]: cases[0]?.id ?? "",
};
const caseSlugOf = (projectName: string) => CASE_PROJECTS[projectName] ?? null;
---

<FieldLayout
  title="Mike Jones: Work"
  description="Three product design case studies written from the receipts, plus the full systems index: nine running projects and four ways to engage."
  active="/work"
  dataTheme="light"
>
  <div class="sheet-rules">

    <!-- Page opening -->
    <section>
      <div class="wrap page-head">
        <h1 class="display reveal">The work.</h1>
        <p class="lede reveal reveal-2">
          Three case studies, written from the receipts: what blocked use, what
          I designed next, and what I still have not proven. The full index of
          systems sits below them.
        </p>
        <p class="resume-slink mono reveal reveal-3">
          The formal file: <a href="/Mike-Jones-Resume.pdf">Résumé (PDF)</a>
        </p>
      </div>
    </section>

    <!-- Case studies: the front door of the page -->
    <section id="case-studies" aria-labelledby="case-studies-h">
      <div class="wrap">
        <div class="section-head reveal">
          <h2 id="case-studies-h">Case studies</h2>
          <p class="hint">
            Each one is a working product I own end to end. The diagnosis, the
            decisions, and the honest residue, in that order.
          </p>
        </div>
      </div>
      <div class="wrap">
        <div class="entries">
          {cases.map((entry, i) => (
            <a class="entry" class:list={{ lead: entry.id === LEAD_CASE }} href={`/work/${entry.id}`}>
              <span class="mono tag">case study<br />{entry.data.tag}</span>
              <span>
                <h3>{entry.data.rowTitle}</h3>
                <p class="diag">{entry.data.diag}</p>
                {entry.id === LEAD_CASE && entry.data.plate && (
                  <span class="plate plate-row">
                    <img src={entry.data.plate.src} alt={entry.data.plate.alt} loading="lazy" />
                  </span>
                )}
              </span>
              <span class="mono state">{entry.data.status}<span class="go">Read the case study</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Ways to engage: the ventures, demoted -->
    <section id="engagements" aria-labelledby="engagements-h">
      <div class="wrap">
        <div class="section-head">
          <h2 id="engagements-h">Ways to engage</h2>
          <p class="hint">Four running ventures. All four links lead off-site.</p>
        </div>
        <ul class="engagements">
          {ventures.map((v) => (
            <li>
              <a class="row" href={v.href} target="_blank" rel="noopener noreferrer">
                <span><span class="name">{v.name}</span><span class="role mono">{v.role}</span></span>
                <span>{v.tagline}</span>
                <span class="mono state">{v.status}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Systems index: the demoted grid, copy verbatim from content.ts -->
    <section id="index" aria-labelledby="index-h">
      <div class="wrap">
        <div class="section-head">
          <h2 id="index-h">Systems index</h2>
          <p class="hint">
            Nine systems, grouped by what they do. Screenshots are real. The
            NeighborhoodShare entry links to its case study.
          </p>
        </div>

        {projectGroups.map((group) => (
          <div class="index-group">
            <h3>{group}</h3>
            <div class="index-items">
              {projects.filter((p) => p.group === group).map((p) => {
                const caseSlug = caseSlugOf(p.name);
                return (
                  <article class="index-item" class:list={{ read: caseSlug !== null }}>
                    {p.img && (
                      <div class="plate">
                        <img src={p.img} alt={p.name} loading="lazy" />
                      </div>
                    )}
                    <h4>
                      {caseSlug ? <a href={`/work/${caseSlug}`}>{p.name}</a> : p.name}
                    </h4>
                    <p>{p.blurb}</p>
                    {p.link && (
                      <a class="more" href={p.link} target="_blank" rel="noopener noreferrer">
                        {p.linkLabel}
                      </a>
                    )}
                    {caseSlug && <a class="more" href="/work/neighborhoodshare">Read the case study</a>}
                    <div class="tags">
                      {p.tags.map((t) => <span>{t}</span>)}
                      {caseSlug && <span>case study</span>}
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Contact band -->
    <section>
      <div class="wrap contact-band">
        <div>
          <h2>Working on something like this?</h2>
          <p class="note">Velocity Partners handles exactly this: making AI actually work inside organizations. Email starts the same conversation.</p>
        </div>
        <div>
          <a href="/contact" class="btn">Start a conversation</a>
          <a href={`mailto:${identity.email}`} class="btn btn-ghost">Email Mike</a>
        </div>
      </div>
    </section>

  </div>
</FieldLayout>