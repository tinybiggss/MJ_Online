---
import FieldLayout from "../layouts/FieldLayout.astro";
import { identity, ventures } from "../lib/content";

const inputClass =
  "w-full rounded-md border border-field-line bg-field-bg px-4 py-3 text-field-ink placeholder:text-field-faint transition-colors focus:border-signal focus:outline-none focus:ring-1 focus:ring-signal aria-[invalid=true]:border-danger";
const errorClass = "hidden text-sm text-danger";

// No-JS fallback: the Pages Function redirects here on a server-side error.
const hadError = Astro.url.searchParams.get("error") === "1";
---

<FieldLayout title="Contact — Mike Jones" active="/contact">
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-12 md:pt-24">
    <h1 class="reveal font-display text-[clamp(2.5rem,6vw,4.5rem)] font-extrabold leading-[1.0] tracking-[-0.03em] text-balance">
      Let's talk.
    </h1>
    <p class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-field-muted" style="animation-delay:.08s">
      Tell me what you're working on and I'll get back to you. Prefer to poke around first? Ask my AI assistant in the corner — it's powered by <a href="https://distills.app" target="_blank" rel="noopener noreferrer" class="text-field-ink underline decoration-field-line underline-offset-4 transition-colors hover:text-signal hover:decoration-signal">Distills</a>, my own career-chatbot product, and it knows my work cold.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-16">
    <div class="grid gap-12 md:grid-cols-[1.3fr_0.7fr]">
      <!-- FORM -->
      <form
        id="contact-form"
        action="/api/contact"
        method="POST"
        novalidate
        class="rounded-2xl border border-field-line bg-field-panel p-6 md:p-8"
      >
        {hadError && (
          <p class="mb-5 rounded-md border border-danger/40 bg-danger/10 px-4 py-3 text-sm text-danger">
            Something went wrong sending your message. Please try again, or email me directly.
          </p>
        )}
        <!-- Honeypot: bots fill this, humans never see it -->
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

        <div class="grid gap-5 sm:grid-cols-2">
          <div class="flex flex-col gap-2">
            <label for="name" class="text-sm font-medium text-field-muted">Name <span class="text-signal">*</span></label>
            <input id="name" name="name" type="text" required autocomplete="name" class={inputClass} placeholder="Your name" />
            <p data-error="name" class={errorClass}></p>
          </div>
          <div class="flex flex-col gap-2">
            <label for="email" class="text-sm font-medium text-field-muted">Email <span class="text-signal">*</span></label>
            <input id="email" name="email" type="email" required autocomplete="email" class={inputClass} placeholder="you@company.com" />
            <p data-error="email" class={errorClass}></p>
          </div>
        </div>

        <div class="mt-5 flex flex-col gap-2">
          <label for="company" class="text-sm font-medium text-field-muted">Company <span class="text-field-faint">(optional)</span></label>
          <input id="company" name="company" type="text" autocomplete="organization" class={inputClass} placeholder="Where you work" />
        </div>

        <div class="mt-5 flex flex-col gap-2">
          <label for="message" class="text-sm font-medium text-field-muted">What's on your mind? <span class="text-signal">*</span></label>
          <textarea id="message" name="message" required rows="6" class={inputClass} placeholder="A sentence or two about what you're working on and how I can help."></textarea>
          <p data-error="message" class={errorClass}></p>
        </div>

        <button id="contact-submit" type="submit" class="mt-7 w-full rounded-md bg-signal px-6 py-3 text-sm font-bold text-field-bg transition-colors hover:bg-signal-deep disabled:opacity-60 sm:w-auto">
          Send message
        </button>
        <p id="form-status" role="status" aria-live="polite" class="mt-4 text-sm text-field-faint">Goes straight to my inbox. I read everything and reply personally.</p>
      </form>

      <!-- DIRECT -->
      <div class="flex flex-col gap-4">
        <a href={`mailto:${identity.email}`} class="group rounded-xl border border-field-line bg-field-panel p-6 transition-colors hover:border-signal">
          <h2 class="font-display text-lg font-bold tracking-tight">Email directly</h2>
          <p class="mt-2 text-sm text-field-muted">{identity.email}</p>
        </a>
        <button type="button" data-open-chat class="group rounded-xl border border-field-line bg-field-panel p-6 text-left transition-colors hover:border-signal">
          <h2 class="font-display text-lg font-bold tracking-tight">Ask my AI</h2>
          <p class="mt-2 text-sm text-field-muted">Questions about my experience or fit? Get answers instantly.</p>
        </button>
        <div class="rounded-xl border border-field-line p-6">
          <h2 class="font-display text-lg font-bold tracking-tight">Based in</h2>
          <p class="mt-2 text-sm text-field-muted">{identity.location}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WAYS TO WORK -->
  <section class="mx-auto max-w-6xl px-6 py-12">
    <h2 class="mb-2 border-b border-field-line pb-4 font-display text-2xl font-bold tracking-tight">Ways to work together</h2>
    <ul>
      {ventures.map((v) => (
        <li>
          <a href={v.href} target="_blank" rel="noopener noreferrer" class="group grid grid-cols-1 gap-2 border-b border-field-line py-6 transition-colors hover:bg-field-panel/60 md:grid-cols-[0.9fr_1.6fr_auto] md:items-baseline md:gap-8">
            <h3 class="font-display text-lg font-bold tracking-tight transition-colors group-hover:text-signal">{v.name}</h3>
            <p class="text-sm text-field-muted">{v.tagline}</p>
            <span class="text-sm text-field-muted md:text-right">{v.role}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-24 pt-4">
    <p class="text-sm text-field-faint">{identity.company} · {identity.location}</p>
  </section>

  <script is:inline>
    const form = document.getElementById("contact-form");
    if (form) {
      const status = document.getElementById("form-status");
      const submit = document.getElementById("contact-submit");
      const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      const setError = (name, msg) => {
        const el = form.querySelector(`[data-error="${name}"]`);
        const input = form.querySelector(`[name="${name}"]`);
        if (el) {
          el.textContent = msg || "";
          el.classList.toggle("hidden", !msg);
        }
        if (input) input.setAttribute("aria-invalid", msg ? "true" : "false");
      };
      const setStatus = (msg, isError) => {
        status.textContent = msg;
        status.className = "mt-4 text-sm " + (isError ? "text-danger" : "text-field-faint");
      };

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        ["name", "email", "message"].forEach((f) => setError(f, ""));
        const data = Object.fromEntries(new FormData(form).entries());

        let bad = false;
        if (!String(data.name || "").trim()) { setError("name", "Please add your name."); bad = true; }
        if (!String(data.email || "").trim()) { setError("email", "Please add your email."); bad = true; }
        else if (!emailRe.test(String(data.email))) { setError("email", "That email doesn't look right."); bad = true; }
        if (!String(data.message || "").trim()) { setError("message", "Please add a message."); bad = true; }
        if (bad) { setStatus("Please check the highlighted fields.", true); return; }

        submit.disabled = true;
        const original = submit.textContent;
        submit.textContent = "Sending…";
        setStatus("", false);

        try {
          const res = await fetch("/api/contact", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });
          const json = await res.json().catch(() => ({}));
          if (res.ok && json.ok) {
            form.innerHTML =
              '<div class="py-10 text-center"><p class="font-display text-3xl font-extrabold text-signal">Message sent.</p><p class="mt-3 text-field-muted">Thanks — it\'s in my inbox and I\'ll reply personally, usually within a day or two.</p></div>';
            return;
          }
          if (json.errors) Object.entries(json.errors).forEach(([k, v]) => setError(k, v));
          setStatus(json.error || "Something went wrong. Please email me directly.", true);
        } catch {
          setStatus("Network error. Please email me directly at " + (form.dataset.email || "mike@mikejones.online") + ".", true);
        } finally {
          submit.disabled = false;
          submit.textContent = original;
        }
      });
    }
  </script>
</FieldLayout>
