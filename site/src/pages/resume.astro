---
import FieldLayout from "../layouts/FieldLayout.astro";
import { identity } from "../lib/content";

const summary =
  "AI Implementation Expert and LLM Integration Specialist with 29 years building and shipping technology — from the original Xbox launch to AI-augmented operating models today. I turn fast-moving AI capability into dependable systems, processes, and teams.";

const expertise = [
  { label: "AI & LLM", items: ["LLM integration", "RAG & context engineering", "Agent orchestration", "Local/self-hosted AI", "AAPD methodology"] },
  { label: "Leadership", items: ["Fractional PMO", "Org & process design", "Teams of 120+", "$12M+ budgets", "P&L ownership"] },
  { label: "Product & Delivery", items: ["0→1 product", "Hardware + software", "Live ops", "Go-to-market", "Patent holder"] },
];

const experience = [
  {
    years: "2023 — present",
    role: "Founder",
    org: "Velocity Partners",
    points: [
      "AI implementation consulting and fractional PMO — helping organizations move AI from demo to dependable.",
      "Built on AAPD (AI-Augmented Process Design); active teaching partnership with Get Hired Now Academy.",
    ],
  },
  {
    years: "2022 — present",
    role: "Independent R&D / Builder",
    org: "Jones Collaboration Company",
    points: [
      "Built a local LLM stack, a cross-AI memory system, and Corvus, a persistent personal AI agent.",
      "Launched Resilient Tomorrow (1,000+ subscribers) and NeighborhoodShare (170 users, 20 communities).",
    ],
  },
  {
    years: "2020 — 2022",
    role: "Principal Technical Program Manager",
    org: "Kinoo",
    points: ["Led technical program management for an AR family-communication platform; CES Innovation Award winner."],
  },
  {
    years: "2017 — 2020",
    role: "Co-founder / CTO",
    org: "8 Circuit Studios",
    points: ["Co-founded a Web3 gaming studio; led technology and a proto-metaverse product vision."],
  },
  {
    years: "2009 — 2015",
    role: "Director-level roles",
    org: "Livescribe · Kabam · Disney Interactive",
    points: ["Product and program leadership across connected hardware (smartpen) and mobile/console gaming."],
  },
  {
    years: "1999 — 2009",
    role: "Program / Technical leadership",
    org: "Microsoft — Xbox & Xbox 360",
    points: [
      "On the launch teams for the original Xbox and Xbox 360; shipped 6 AAA titles.",
      "Hold a patent for an Xbox SDK instrumentation method (the VINCE tool).",
    ],
  },
];

const recognition = [
  "Patent holder — Xbox SDK instrumentation method (VINCE)",
  "CES Innovation Award — Kinoo",
  "Top 1% ChatGPT user globally (top 3% by conversation volume)",
  "Led teams of 50–120+ people; managed $4M–$12M+ budgets",
];
---

<FieldLayout title="Résumé — Mike Jones" active="/resume">
  <section class="mx-auto max-w-4xl px-6 pt-16 pb-10 md:pt-24">
    <div class="reveal flex flex-col justify-between gap-6 border-b border-field-line pb-8 sm:flex-row sm:items-end">
      <div>
        <h1 class="font-display text-[clamp(2.25rem,5vw,3.5rem)] font-extrabold leading-none tracking-[-0.03em]">Mike Jones</h1>
        <p class="mt-3 font-display text-lg text-signal">{identity.title}</p>
      </div>
      <div class="flex shrink-0 flex-wrap gap-3">
        <a href="/Mike-Jones-Resume.pdf" download class="rounded-md bg-signal px-5 py-2.5 text-sm font-bold text-field-bg transition-colors hover:bg-signal-deep">Download PDF</a>
        <a href={`mailto:${identity.email}`} class="rounded-md border border-field-line px-5 py-2.5 text-sm font-medium text-field-ink transition-colors hover:border-signal hover:text-signal">{identity.email}</a>
      </div>
    </div>
    <p class="mt-8 max-w-3xl text-lg leading-relaxed text-field-muted">{summary}</p>
  </section>

  <!-- EXPERTISE -->
  <section class="mx-auto max-w-4xl px-6 py-10">
    <h2 class="mb-6 font-display text-2xl font-bold tracking-tight">Core expertise</h2>
    <div class="grid gap-x-10 gap-y-8 sm:grid-cols-3">
      {expertise.map((group) => (
        <div>
          <h3 class="font-display text-sm font-bold uppercase tracking-wide text-signal">{group.label}</h3>
          <ul class="mt-3 space-y-1.5 text-sm text-field-muted">
            {group.items.map((it) => <li>{it}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section class="mx-auto max-w-4xl px-6 py-10">
    <h2 class="mb-2 border-b border-field-line pb-4 font-display text-2xl font-bold tracking-tight">Experience</h2>
    <div>
      {experience.map((job) => (
        <article class="grid grid-cols-1 gap-2 border-b border-field-line py-7 md:grid-cols-[150px_1fr] md:gap-8">
          <span class="text-sm text-signal">{job.years}</span>
          <div>
            <h3 class="font-display text-lg font-bold tracking-tight">{job.role} <span class="text-field-muted">· {job.org}</span></h3>
            <ul class="mt-2 space-y-1.5 text-sm leading-relaxed text-field-muted">
              {job.points.map((p) => <li>{p}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- RECOGNITION -->
  <section class="mx-auto max-w-4xl px-6 py-10 pb-24">
    <h2 class="mb-6 font-display text-2xl font-bold tracking-tight">Recognition</h2>
    <ul class="space-y-3">
      {recognition.map((r) => (
        <li class="flex gap-3 text-field-muted">
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-signal" aria-hidden="true"></span>
          <span>{r}</span>
        </li>
      ))}
    </ul>
  </section>
</FieldLayout>
