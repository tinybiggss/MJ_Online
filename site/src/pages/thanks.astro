---
import FieldLayout from "../layouts/FieldLayout.astro";
---

<FieldLayout title="Thanks — Mike Jones" description="Your message was sent.">
  <section class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-center justify-center px-6 py-24 text-center">
    <p class="font-display text-6xl font-extrabold tracking-tight text-signal">✓</p>
    <h1 class="mt-4 font-display text-3xl font-bold tracking-tight md:text-4xl">Message sent.</h1>
    <p class="mt-4 max-w-md text-field-muted">Thanks for reaching out — it's in my inbox and I'll reply personally, usually within a day or two.</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="rounded-md bg-signal px-6 py-3 text-sm font-bold text-field-bg transition-colors hover:bg-signal-deep">Back home</a>
      <a href="/work" class="rounded-md border border-field-line px-6 py-3 text-sm font-medium text-field-ink transition-colors hover:border-signal hover:text-signal">See the work</a>
    </div>
  </section>
</FieldLayout>
