---
import Base from "../layouts/Base.astro";
import SlideFund from "../components/slide/SlideFund.tsx";
---

<Base
  title="Help Cover the Slide 🐬🎆 | 4th of July"
  description="We rented a giant dolphin slide for the 4th of July — chip in to help cover the cost."
  noindex={true}
>
  <main class="mx-auto max-w-2xl px-4 py-6 sm:py-8">
    <header class="mb-5 text-center">
      <h1 class="font-display text-[clamp(1.6rem,4vw,2.5rem)] font-extrabold leading-[1.05] tracking-[-0.03em] text-balance">The Great Dolphin Slide 🐬</h1>
      <p class="mt-2 text-base leading-relaxed text-field-muted">
        Our 4th of July dolphin slide cost <span class="text-field-ink font-medium">$708.49</span>. I've got the first <span class="text-field-ink font-medium">$100</span> — chip in to help cover the rest! 🎆
      </p>
    </header>

    <SlideFund client:load />

    <p class="mt-10 text-center text-xs text-field-faint">
      Donations go straight to Venmo. The total here is self-reported for fun — thanks for being honest!
    </p>
  </main>
</Base>
