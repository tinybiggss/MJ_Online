---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Tailwind classes applied to <body> — sets per-direction background/text. */
  bodyClass?: string;
  /** If true, renders a noindex/nofollow meta tag (for unlisted pages). */
  noindex?: boolean;
  /** Social share image, relative to site root. Defaults to the branded card. */
  image?: string;
  /** Optional theme pin for document pages: "light" = paper. Unset = desk (site default). */
  dataTheme?: "light" | "dark" | "auto";
}

const {
  title = "Mike Jones — AI Implementation Expert",
  description = "Mike Jones helps people and organizations operate at the intersection of AI, autonomy, and resilience. 29 years building systems that ship.",
  bodyClass = "bg-field-bg text-field-ink font-body antialiased",
  noindex = false,
  image = "/img/og-default.png",
  dataTheme = undefined,
} = Astro.props;

// Absolute URLs for social meta (Open Graph / Twitter require them).
// Astro.site is set to https://mikejones.online in astro.config.mjs.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" {...dataTheme ? { "data-theme": dataTheme } : {}}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/img/logos/favicon-jones-co.png" />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Mike Jones" />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mike Jones — Fractional VP of Product &amp; CAIO. I define the product, then ship it — with AI." />
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
