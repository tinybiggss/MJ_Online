---
import Base from "./Base.astro";
import ChatbotSlot from "../components/ChatbotSlot.astro";
import { identity, nav } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
  /** Current path, used to mark the active nav item. */
  active?: string;
}
const { title, description, active = "" } = Astro.props;
const isActive = (href: string) => active === href || (href !== "/" && active.startsWith(href));
---

<Base title={title} description={description}>
  <link
    slot="head"
    rel="stylesheet"
    href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@500,700,800,900&f[]=satoshi@400,500,700&display=swap"
  />

  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-signal focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-field-bg"
    >Skip to content</a
  >

  <header class="sticky top-0 z-40 border-b border-field-line/70 bg-field-bg/85 backdrop-blur-md">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="/" class="font-display text-lg font-bold tracking-tight">
        Mike Jones<span class="text-signal">.</span>
      </a>
      <div class="hidden items-center gap-9 md:flex">
        {nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "text-sm transition-colors hover:text-field-ink",
              isActive(item.href) ? "text-field-ink" : "text-field-muted",
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}
      </div>
      <div class="flex items-center gap-2">
        <a
          href="/contact"
          class="hidden rounded-md bg-signal px-4 py-2 text-sm font-bold text-field-bg transition-colors hover:bg-signal-deep md:inline-flex"
          >Start a conversation</a
        >
        <button
          id="menu-toggle"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="nav-toggle -mr-2 inline-flex h-10 w-10 items-center justify-center rounded-md text-field-ink transition-colors hover:bg-field-panel md:hidden"
        >
          <span class="sr-only">Toggle navigation</span>
          <span aria-hidden="true">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
          </span>
        </button>
      </div>
    </nav>

    <!-- Mobile navigation panel -->
    <div id="mobile-menu" data-open="false" class="md:hidden">
      <div class="menu-inner">
        <div class="flex flex-col gap-1 border-t border-field-line/70 px-6 pb-6 pt-2">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                "rounded-md px-2 py-3 text-base transition-colors hover:bg-field-panel",
                isActive(item.href) ? "font-semibold text-field-ink" : "text-field-muted",
              ]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
          <a
            href="/resume"
            class:list={[
              "rounded-md px-2 py-3 text-base transition-colors hover:bg-field-panel",
              isActive("/resume") ? "font-semibold text-field-ink" : "text-field-muted",
            ]}
            aria-current={isActive("/resume") ? "page" : undefined}
          >
            Résumé
          </a>
          <a
            href="/contact"
            class="mt-3 rounded-md bg-signal px-4 py-3 text-center text-base font-bold text-field-bg transition-colors hover:bg-signal-deep"
            >Start a conversation</a
          >
        </div>
      </div>
    </div>
  </header>

  <script>
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    if (toggle && menu) {
      const setOpen = (open: boolean) => {
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        menu.dataset.open = String(open);
      };
      toggle.addEventListener("click", () => {
        setOpen(toggle.getAttribute("aria-expanded") !== "true");
      });
      // Tapping any link navigates — collapse the panel as it goes.
      menu.querySelectorAll("a").forEach((link) =>
        link.addEventListener("click", () => setOpen(false)),
      );
      // Escape closes and returns focus to the toggle.
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
          setOpen(false);
          toggle.focus();
        }
      });
    }
  </script>

  <main id="main">
    <slot />
  </main>

  <footer class="border-t border-field-line">
    <div class="mx-auto max-w-6xl px-6 py-12">
      <div class="flex flex-col justify-between gap-8 md:flex-row">
        <div class="max-w-sm">
          <a href="/" class="font-display text-lg font-bold tracking-tight">
            Mike Jones<span class="text-signal">.</span>
          </a>
          <p class="mt-3 text-sm leading-relaxed text-field-muted">{identity.tagline}</p>
        </div>
        <nav class="flex flex-wrap gap-x-10 gap-y-3 text-sm" aria-label="Footer">
          <div class="flex flex-col gap-2">
            {nav.map((item) => (
              <a href={item.href} class="text-field-muted transition-colors hover:text-field-ink">{item.label}</a>
            ))}
            <a href="/resume" class="text-field-muted transition-colors hover:text-field-ink">Résumé</a>
          </div>
          <div class="flex flex-col gap-2">
            <a href="https://resilient-tomorrow.com" target="_blank" rel="noopener noreferrer" class="text-field-muted transition-colors hover:text-field-ink">Resilient Tomorrow</a>
            <a href="https://distills.app" target="_blank" rel="noopener noreferrer" class="text-field-muted transition-colors hover:text-field-ink">Distills</a>
            <a href={`mailto:${identity.email}`} class="text-field-muted transition-colors hover:text-field-ink">{identity.email}</a>
          </div>
        </nav>
      </div>
      <div class="mt-10 flex flex-col items-start justify-between gap-2 border-t border-field-line pt-6 text-sm text-field-faint sm:flex-row sm:items-center">
        <span>© {new Date().getFullYear()} {identity.company}</span>
        <span>{identity.location}</span>
      </div>
    </div>
  </footer>

  <ChatbotSlot />
</Base>
