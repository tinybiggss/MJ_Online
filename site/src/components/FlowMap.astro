---
/**
 * FlowMap.astro — how the system fits together, in one picture.
 *
 * Authored here rather than generated by a diagram tool: every count on it has
 * to come from atlas.json, and a PNG with baked-in numbers would go stale the
 * first time a loop was added — the exact failure this page exists to avoid.
 *
 * Real DOM text, not an image: it survives copy/paste, screen readers, and a
 * 390px viewport. Connectors are decorative and hidden from assistive tech.
 */
import { stats } from "../lib/atlas";

const bandCount = (id: string) => (stats.by_band?.[id] ?? 0) as number;
const gates = (stats.by_pattern?.gate ?? 0) as number;

type Node = { name: string; sub: string; accent?: boolean };

const stages: { rail: string; label: string; count: string; nodes: Node[]; produced: string }[] = [
  {
    rail: "01",
    label: "Harvest",
    count: `${bandCount("harvest")} loops`,
    nodes: [{ name: "The world", sub: "calendar · mail · web · repos" }],
    produced: "what the world pushed at you, timestamped and nothing else.",
  },
  {
    rail: "02",
    label: "Tend",
    count: `${bandCount("tend")} loops`,
    nodes: [
      { name: "Arrivals", sub: "intake files one object each" },
      { name: "Filed objects", sub: "cards · notes · drafts" },
    ],
    produced: "state you can trust without re-checking it.",
  },
  {
    rail: "03",
    label: "Orient",
    count: `${bandCount("orient")} loops`,
    nodes: [
      { name: "The one page", sub: "brief, on a clock" },
      { name: "Your decision", sub: "the only place a decision happens", accent: true },
    ],
    produced: "a decision before you would have gone looking for one.",
  },
  {
    rail: "04",
    label: "Ship",
    count: `${gates} gates`,
    nodes: [
      { name: "Work in flight", sub: "cards with an owner" },
      { name: "Gate", sub: "pass or refuse — nothing else" },
      { name: "Published", sub: "this site · delivery · mail" },
    ],
    produced: "output that was checked before it counted.",
  },
  {
    rail: "05",
    label: "Close",
    count: `${bandCount("close")} loops`,
    nodes: [{ name: "Review & plan", sub: "weekly · monthly" }],
    produced: "the next week's objects, and what to stop.",
  },
];

const connectors = [
  "pulled in on a clock",
  "filed, deduped",
  "compressed to one screen",
  "becomes cards",
  "only on a pass",
];
---

<figure class="not-prose">
  <div class="border-t border-field-line">
    {stages.map((s, i) => (
      <>
        <div class="grid gap-x-6 gap-y-2 border-b border-field-line py-5 md:grid-cols-[6.5rem_1fr] md:gap-x-8 md:py-6">
          <!-- rail -->
          <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
            <span class="font-data text-2xs tabular-nums text-signal">{s.rail}</span>
            <span class="font-data text-2xs uppercase tracking-[0.14em] text-field-ink">{s.label}</span>
            <span class="basis-full font-data text-2xs tracking-[0.06em] text-field-faint">{s.count}</span>
          </div>

          <!-- flow nodes, each arrow bound to the node it points at -->
          <div>
            <div class="flex flex-wrap items-stretch gap-y-2">
              {s.nodes.map((n, j) => (
                <div class="flex items-stretch">
                  {j > 0 && (
                    <span aria-hidden="true" class="flex items-center px-2 text-field-faint">
                      <svg width="14" height="8" viewBox="0 0 14 8" fill="none" class="overflow-visible">
                        <path d="M0 4h11M8.5 1l3 3-3 3" stroke="currentColor" stroke-width="1" />
                      </svg>
                    </span>
                  )}
                  <div
                    class:list={[
                      "rounded-[3px] border px-3 py-2",
                      n.accent ? "border-signal bg-signal/[0.06]" : "border-field-line bg-field-panel",
                    ]}
                  >
                    <p class:list={["font-display text-sm font-semibold leading-snug", n.accent && "text-signal"]}>
                      {n.name}
                    </p>
                    <p class="mt-0.5 font-data text-2xs leading-relaxed text-field-faint">{n.sub}</p>
                  </div>
                </div>
              ))}
            </div>

            <p class="mt-3 font-data text-2xs leading-relaxed text-field-faint">
              <span class="text-field-muted">yields</span> — {s.produced}
            </p>
          </div>
        </div>

        {i < stages.length - 1 && (
          <div class="grid md:grid-cols-[6.5rem_1fr] md:gap-x-8">
            <div />
            <div class="flex items-center gap-2.5 border-l border-dashed border-field-line py-1.5 pl-3 md:pl-4">
              <svg aria-hidden="true" width="9" height="18" viewBox="0 0 9 18" fill="none" class="overflow-visible">
                <path d="M4.5 0v13M1 10l3.5 3.5L8 10" stroke="currentColor" stroke-width="1" class="text-field-faint" />
              </svg>
              <span class="font-data text-2xs uppercase tracking-[0.1em] text-field-faint">{connectors[i]}</span>
            </div>
          </div>
        )}
      </>
    ))}

    <!-- ------------------------------------------------------- return path -->
    <div class="grid border-b border-field-line py-4 md:grid-cols-[6.5rem_1fr] md:gap-x-8">
      <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
        <span aria-hidden="true" class="font-data text-2xs text-signal">↰</span>
        <span class="font-data text-2xs uppercase tracking-[0.14em] text-field-ink">Return</span>
      </div>
      <p class="font-data text-2xs leading-relaxed text-field-faint">
        <span class="uppercase tracking-[0.1em] text-field-muted">to 02 · tend</span> — the review writes the next
        week's objects back into what tended them, which is what makes this a loop and not a funnel.
      </p>
    </div>
  </div>

  <!-- ------------------------------------------------------- control strip -->
  <div class="mt-8 grid gap-3 md:grid-cols-[6.5rem_1fr] md:gap-x-8">
    <p class="font-data text-2xs uppercase tracking-[0.14em] text-field-faint md:pt-1.5">Control</p>
    <div>
      <div class="flex flex-wrap gap-2">
        {["Publish guard", "Repair", "First-failure ping"].map((c) => (
          <span class="rounded-[3px] border border-dashed border-field-line px-2.5 py-1 font-data text-2xs text-field-muted">
            {c}
          </span>
        ))}
      </div>
      <p class="mt-3 max-w-[62ch] text-[0.8125rem] leading-relaxed text-field-muted">
        The loops that look after the loops. They own no stage — they watch all five, which is why a failure arrives as
        a message instead of as a discovery.
      </p>
    </div>
  </div>

  <!-- --------------------------------------------------------- foundation -->
  <div class="mt-6 grid gap-3 md:grid-cols-[6.5rem_1fr] md:gap-x-8">
    <p class="font-data text-2xs uppercase tracking-[0.14em] text-field-faint md:pt-1.5">Underneath</p>
    <div class="rounded-[3px] border border-field-line bg-field-panel px-3 py-2.5">
      <p class="font-display text-sm font-semibold">Memory</p>
      <p class="mt-0.5 font-data text-2xs leading-relaxed text-field-faint">
        identity · voice · decisions already made
      </p>
      <p class="mt-2 max-w-[62ch] text-[0.8125rem] leading-relaxed text-field-muted">
        The layer every stage reads from. It is what makes {stats.loops_running} separate loops behave like one system
        instead of {stats.loops_running} separate opinions.
      </p>
    </div>
  </div>

  <figcaption class="mt-8 max-w-[70ch] border-l-2 border-signal pl-4 text-sm leading-relaxed text-field-muted">
    Nothing in this picture is a diagram of software. It is a diagram of a decision cycle — the loops exist so that the
    expensive part, knowing what to do next, happens once a day instead of once an hour.
  </figcaption>
</figure>
