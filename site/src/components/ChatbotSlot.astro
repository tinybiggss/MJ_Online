---
/**
 * ChatbotSlot — the site's AI assistant.
 *
 * Loads the Distills-generated career bot (Mike's own product). The widget
 * self-configures via window.RAG_CHATBOT_CONFIG set at the top of
 * /distill-chatbot-widget.js (API endpoint, accent color, greeting,
 * suggested questions). To regenerate, replace that file from Distills.
 */
---

<script is:inline src="/distill-chatbot-widget.js" defer></script>

<!-- Wire any [data-open-chat] trigger on the page to open the assistant -->
<script is:inline>
  document.addEventListener("click", function (event) {
    const trigger = event.target.closest("[data-open-chat]");
    if (!trigger) return;
    event.preventDefault();
    const bubble = document.querySelector(".rag-chatbot-bubble");
    if (bubble) bubble.click();
  });
</script>
